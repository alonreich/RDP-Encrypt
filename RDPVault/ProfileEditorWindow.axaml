<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RDPVault.ProfileEditorWindow"
        Title="Edit Profile" Width="420" Height="580"
        Icon="avares://RDPVault/Assets/icon.ico"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="#0E0E10" Foreground="#EDEDED" FontFamily="Inter, Arial">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#141417"/>
            <Setter Property="BorderBrush" Value="#2E2E35"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="#005FB8"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#2E2E35"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A30"/>
        </Style>
        <Style Selector="Button.Accent">
            <Setter Property="Background" Value="#005FB8"/>
            <Setter Property="BorderBrush" Value="#006CD0"/>
        </Style>
        <Style Selector="Button.Accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#006CD0"/>
        </Style>
    </Window.Styles>
    
    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="PROFILE SETTINGS" FontSize="18" FontWeight="Bold" LetterSpacing="1" Margin="0,0,0,10"/>
        
        <TextBlock Text="Display Name" FontSize="13" Foreground="#8A8A93"/>
        <TextBox Name="TxtName" Watermark="e.g. Production Server"/>
        
        <Grid ColumnDefinitions="*,10,100">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Host / IP Address" FontSize="13" Foreground="#8A8A93"/>
                <TextBox Name="TxtHost" Watermark="e.g. 192.168.1.100"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Port" FontSize="13" Foreground="#8A8A93"/>
                <TextBox Name="TxtPort" Watermark="3389"/>
            </StackPanel>
        </Grid>
        
        <TextBlock Text="Username" FontSize="13" Foreground="#8A8A93"/>
        <TextBox Name="TxtUsername" Watermark="Administrator"/>
        
        <TextBlock Text="Password" FontSize="13" Foreground="#8A8A93"/>
        <TextBox Name="TxtPassword" PasswordChar="•" Watermark="Secret Password"/>
        
        <TextBlock Text="Display Resolution" FontSize="13" Foreground="#8A8A93" Margin="0,5,0,0"/>
        <ComboBox Name="CmbResolution" HorizontalAlignment="Stretch" Background="#141417" BorderBrush="#2E2E35" Foreground="#EDEDED">
            <ComboBoxItem Content="Full Screen"/>
            <ComboBoxItem Content="Use All Monitors (Multi-Mon)"/>
            <ComboBoxItem Content="1920 x 1080"/>
            <ComboBoxItem Content="1600 x 900"/>
            <ComboBoxItem Content="1366 x 768"/>
            <ComboBoxItem Content="1280 x 1024"/>
            <ComboBoxItem Content="1280 x 800"/>
            <ComboBoxItem Content="1024 x 768"/>
            <ComboBoxItem Content="800 x 600"/>
        </ComboBox>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"/>
            <Button Name="BtnSave" Content="Save Profile" Classes="Accent" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
