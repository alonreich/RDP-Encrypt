<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>

    <!-- Required for the IShellLink COM interop in ShellLink.cs. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!--
      ISSUE #16 - honest build settings.
      project_structure.txt claimed "NativeAOT-compiled" and the docs told agents the
      canonical build produced a NativeAOT binary. There was no PublishAot property
      anywhere: this is, and always was, a self-contained single-file build. It is
      also the correct choice here - WinRT (Windows Hello), COM interop and the
      managed Argon2 implementation are all awkward under full AOT.
      Trimming is explicitly disabled because ShellLink.cs uses COM interfaces that a
      trimmer cannot see.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <!--
      Removed (issue #16):
        System.Management                          - pulled in a WMI dependency nothing used.
        System.Security.Cryptography.ProtectedData - DPAPI was dropped from the design
                                                     but the package reference stayed behind.
    -->
  </ItemGroup>
</Project>
