<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RDPVault.Android.Views.MainView"
             Background="#0E0E10"
             Foreground="#EDEDED">

    <!--
      SIZING POLICY (audit item 9):
      Interactive controls use MinHeight, never a fixed Height, so that a phone set to a
      large system font size grows the control instead of clipping the text inside it.
      No user-facing text is below 12px; body copy is 13px.
    -->
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <!-- Long checkbox labels are supplied as explicit wrapping TextBlocks rather than
             bare strings, because a bare string content is laid out on a single line. -->
        <Style Selector="CheckBox TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- ==================== 1. FIRST-TIME SETUP WIZARD ==================== -->
        <ScrollViewer Name="PanelFirstRun" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,54,20,32" Spacing="16">
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="0,8,0,12">
                    <TextBlock Text="RDP VAULT" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" LetterSpacing="2"/>
                    <TextBlock Text="Initial Vault Setup" FontSize="16" FontWeight="SemiBold" Foreground="#26A0DA" HorizontalAlignment="Center"/>
                    <TextBlock Text="Welcome! Create a secure master vault to protect your remote connections." FontSize="13" Foreground="#8A8A93" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Master Password Card -->
                <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="CREATE MASTER PASSWORD" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="TxtFirstRunPass" PasswordChar="●" Watermark="Master password (min 8 characters)..."
                                     Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                            <Button Grid.Column="1" Name="BtnToggleFirstRunPass" Content="👁" Background="#1C1C21" Foreground="#9A9AA3"
                                    BorderBrush="#2E2E35" MinWidth="48" Margin="6,0,0,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="TxtFirstRunConfirm" PasswordChar="●" Watermark="Confirm master password..."
                                     Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                            <Button Grid.Column="1" Name="BtnToggleFirstRunConfirm" Content="👁" Background="#1C1C21" Foreground="#9A9AA3"
                                    BorderBrush="#2E2E35" MinWidth="48" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="There is no way to reset this password except the recovery code you are about to receive. Nothing is sent anywhere - the vault lives on this phone only."
                                   FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Hardware Security Card -->
                <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="BIOMETRICS &amp; SECURITY" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                        <CheckBox Name="ChkFirstRunBiometrics" Content="Enable Fingerprint / Face Unlock" IsChecked="True" Foreground="#EDEDED"/>
                        <TextBlock Name="TxtFirstRunBiometricsHint"
                                   Text="Your master key is sealed inside this phone's security chip and can only be released by your fingerprint or face. Adding a new fingerprint later cancels the seal on purpose."
                                   FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Requirement notice -->
                <Border Background="#141A22" BorderBrush="#24405C" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="YOU ALSO NEED A REMOTE DESKTOP APP" FontSize="12" FontWeight="Bold" Foreground="#8AB4F8" LetterSpacing="1"/>
                        <TextBlock Text="RDP Vault stores and protects your connections, then hands them to Microsoft Remote Desktop (free, from Google Play). If it is not installed, RDP Vault will offer to install it the first time you connect."
                                   FontSize="12" Foreground="#C7C7D1" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Name="TxtFirstRunError" Foreground="#FF6B6B" FontSize="13" HorizontalAlignment="Center"
                           IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>

                <Button Name="BtnFirstRunCreate" Content="Create Encrypted Vault" HorizontalAlignment="Stretch"
                        Background="#005FB8" Foreground="White" MinHeight="50" CornerRadius="6" FontSize="15" FontWeight="SemiBold"/>

                <Button Name="BtnFirstRunImportExisting" Content="📂 Open / Import Existing Vault File" HorizontalAlignment="Stretch"
                        Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="6"/>

                <StackPanel Name="PnlFirstRunProgress" Spacing="6" Margin="0,4,0,0" IsVisible="False">
                    <ProgressBar IsIndeterminate="True" Height="4" Foreground="#005FB8" Background="#1C1C21"/>
                    <TextBlock Text="Creating and securing your vault..." FontSize="13" Foreground="#8A8A93" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 2. RECOVERY CODE DISPLAY PANEL ==================== -->
        <ScrollViewer Name="PanelRecoveryDisplay" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,54,20,32" Spacing="16">
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="0,8,0,12">
                    <TextBlock Text="🔑" FontSize="32" HorizontalAlignment="Center"/>
                    <TextBlock Text="EMERGENCY RECOVERY CODE" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" LetterSpacing="1" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="52 characters. If you ever forget your master password this code is the ONLY way back into your vault. Save it somewhere off this phone."
                               FontSize="13" Foreground="#8A8A93" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Background="#2A1F0A" BorderBrush="#5A431A" BorderThickness="1" CornerRadius="8" Padding="14">
                    <TextBlock Text="WARNING: Anyone holding this code can unlock your vault. Keep it private, and keep it somewhere that is not this phone."
                               Foreground="#E8A030" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>

                <!-- Code Display Box (Full 52 Crockford-32 Characters) -->
                <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                    <SelectableTextBlock Name="TxtRecoveryDisplayCode" Text="---- ---- ---- ---- ---- ---- ---- ---- ---- ---- ---- ---- ----"
                                         FontFamily="Consolas, Courier New, monospace" FontSize="16" FontWeight="Bold"
                                         Foreground="#26A0DA" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>

                <!-- Three independent escape routes, so the clipboard is never the only one -->
                <TextBlock Text="SAVE IT USING ANY OF THESE" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                <Grid ColumnDefinitions="*,8,*">
                    <Button Grid.Column="0" Name="BtnSaveRecoveryCodeFile" Content="💾 Save as file" Background="#2E2E35" Foreground="#EDEDED"
                            CornerRadius="6" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="2" Name="BtnShareRecoveryCode" Content="📤 Share" Background="#2E2E35" Foreground="#EDEDED"
                            CornerRadius="6" HorizontalAlignment="Stretch"/>
                </Grid>
                <Button Name="BtnCopyRecoveryCode" Content="📋 Copy to clipboard (auto-clears in 60s)" HorizontalAlignment="Stretch"
                        Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="6"/>

                <TextBlock Name="TxtCopyNotice" Text="" Foreground="#2FBF71" FontSize="13" HorizontalAlignment="Center"
                           IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>

                <CheckBox Name="ChkConfirmRecoverySaved" Content="I have safely recorded this recovery code somewhere other than this phone" Foreground="#EDEDED" Margin="0,8,0,0"/>

                <TextBlock Name="TxtRecoveryGateHint" Text="The Back button is disabled on this screen until the box above is ticked - losing this code means losing the vault."
                           FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>

                <Button Name="BtnFinishSetupAndEnter" Content="Enter Vault" HorizontalAlignment="Stretch"
                        Background="#005FB8" Foreground="White" MinHeight="50" CornerRadius="6" FontSize="15" FontWeight="SemiBold" IsEnabled="False"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 3. LOCKED PANEL (VAULT EXISTS) ==================== -->
        <ScrollViewer Name="PanelLocked" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,56,20,28" Spacing="16">
                <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,16,0,16">
                    <TextBlock Text="RDP VAULT" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" LetterSpacing="2"/>
                    <TextBlock Text="Hardware-Encrypted Mobile Remote Desktop" FontSize="13" Foreground="#8A8A93" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Hardware Biometric Card (Only visible when enrolled) -->
                <Border Name="PnlBiometricCard" Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock Text="DEVICE BIOMETRICS" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                        <Button Name="BtnBiometricUnlock" HorizontalAlignment="Stretch"
                                Background="#005FB8" Foreground="White" MinHeight="50" CornerRadius="6" FontSize="15" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🔒" VerticalAlignment="Center"/>
                                <TextBlock Text="Unlock with Fingerprint / Face" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Master Password Unlock Card -->
                <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="MASTER PASSWORD" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="TxtPassword" PasswordChar="●" Watermark="Enter master password..."
                                     Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                            <Button Grid.Column="1" Name="BtnToggleUnlockPass" Content="👁" Background="#1C1C21" Foreground="#9A9AA3"
                                    BorderBrush="#2E2E35" MinWidth="48" Margin="6,0,0,0"/>
                        </Grid>
                        <Button Name="BtnUnlock" Content="Unlock Vault" HorizontalAlignment="Stretch"
                                Background="#005FB8" Foreground="White" MinHeight="48" CornerRadius="6" FontSize="15" FontWeight="SemiBold"/>

                        <TextBlock Name="TxtLockNotice" Foreground="#2FBF71" FontSize="13" HorizontalAlignment="Center"
                                   IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>

                        <TextBlock Name="TxtLockError" Foreground="#FF6B6B" FontSize="13" HorizontalAlignment="Center"
                                   IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>

                        <StackPanel Name="PnlUnlockProgress" Spacing="6" Margin="0,4,0,0" IsVisible="False">
                            <ProgressBar IsIndeterminate="True" Height="4" Foreground="#005FB8" Background="#1C1C21"/>
                            <TextBlock Name="TxtUnlockStatus" Text="Verifying password and unlocking..." FontSize="13" Foreground="#8A8A93" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recovery Code link -->
                <Button Name="BtnShowRecovery" Content="Forgot Master Password? Use Recovery Code"
                        Background="Transparent" Foreground="#9A9AA3" FontSize="13" HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 4. RECOVERY UNLOCK PANEL ==================== -->
        <ScrollViewer Name="PanelRecoveryUnlock" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,54,20,32" Spacing="16">
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="0,8,0,12">
                    <TextBlock Text="VAULT RECOVERY" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" LetterSpacing="1" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Enter your 52-character recovery code to set a new master password."
                               FontSize="13" Foreground="#8A8A93" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="RECOVERY CODE" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="TxtRecoveryInput" Watermark="XXXX-XXXX-XXXX-... (52 characters)"
                                     Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" FontSize="14"
                                     AcceptsReturn="False" TextWrapping="Wrap"
                                     FontFamily="Consolas, Courier New, monospace"/>
                            <Button Grid.Column="1" Name="BtnPasteRecoveryCode" Content="📋 Paste" Background="#1C1C21" Foreground="#EDEDED"
                                    BorderBrush="#2E2E35" BorderThickness="1" Margin="6,0,0,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Name="TxtRecoveryCharCount" Text="0 / 52 characters" FontSize="12" Foreground="#9A9AA3" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Name="BtnClearRecoveryInput" Content="Clear" Background="Transparent" Foreground="#9A9AA3"
                                    FontSize="12" MinHeight="32" Padding="8,2"/>
                        </Grid>

                        <TextBlock Text="NEW MASTER PASSWORD" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="TxtRecoveryNewPass" PasswordChar="●" Watermark="New master password (min 8 chars)..."
                                     Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                            <Button Grid.Column="1" Name="BtnToggleRecoveryNewPass" Content="👁" Background="#1C1C21" Foreground="#9A9AA3"
                                    BorderBrush="#2E2E35" MinWidth="48" Margin="6,0,0,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="TxtRecoveryConfirmPass" PasswordChar="●" Watermark="Confirm new master password..."
                                     Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                            <Button Grid.Column="1" Name="BtnToggleRecoveryConfirmPass" Content="👁" Background="#1C1C21" Foreground="#9A9AA3"
                                    BorderBrush="#2E2E35" MinWidth="48" Margin="6,0,0,0"/>
                        </Grid>

                        <TextBlock Name="TxtRecoveryUnlockError" Foreground="#FF6B6B" FontSize="13" HorizontalAlignment="Center"
                                   IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>

                        <TextBlock Text="Recovering replaces your master password AND issues a brand new recovery code. The code you type in here stops working the moment recovery succeeds."
                                   FontSize="12" Foreground="#E8A030" TextWrapping="Wrap"/>

                        <Button Name="BtnSubmitRecoveryUnlock" Content="Recover &amp; Reset Password" HorizontalAlignment="Stretch"
                                Background="#005FB8" Foreground="White" MinHeight="48" CornerRadius="6" FontSize="15" FontWeight="SemiBold"/>

                        <Button Name="BtnCancelRecoveryUnlock" Content="Back to Lock Screen" HorizontalAlignment="Stretch"
                                Background="Transparent" Foreground="#9A9AA3" FontSize="13"/>

                        <StackPanel Name="PnlRecoveryUnlockProgress" Spacing="6" Margin="0,4,0,0" IsVisible="False">
                            <ProgressBar IsIndeterminate="True" Height="4" Foreground="#005FB8" Background="#1C1C21"/>
                            <TextBlock Text="Verifying emergency recovery code..." FontSize="13" Foreground="#8A8A93" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 5. UNLOCKED PANEL ==================== -->
        <Grid Name="PanelUnlocked" RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="16,52,16,16" IsVisible="False">
            <!-- Header Bar -->
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="RDP VAULT" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Name="BtnAddProfile" Content="+ Add" Background="#005FB8" Foreground="White"
                            Margin="0,0,6,0" CornerRadius="4" MinHeight="40" Padding="14,6"/>
                    <Button Grid.Column="2" Name="BtnSettings" Content="⚙" Background="#1C1C21" Foreground="#EDEDED"
                            Margin="0,0,6,0" CornerRadius="4" MinHeight="40" MinWidth="44" Padding="8,6"/>
                    <Button Grid.Column="3" Name="BtnLock" Content="Lock" Background="#2E2E35" Foreground="#EDEDED"
                            CornerRadius="4" MinHeight="40" Padding="14,6"/>
                </Grid>
                <TextBlock Grid.Row="1" Name="TxtUnlockedStatus" Text="Vault Unlocked"
                           FontSize="12" Foreground="#2FBF71" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!-- Remote Desktop hand-off banner. No dismiss control by design: while a
                 hand-off is being tracked the user must always keep a one-tap route back. -->
            <Border Grid.Row="1" Name="BannerActiveSession" Background="#162719" BorderBrush="#2FBF71" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" IsVisible="False">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Name="TxtActiveSessionDot" Text="●" FontSize="12" Foreground="#2FBF71" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtActiveSessionHeading" Text="HANDED OFF TO REMOTE DESKTOP" FontSize="12" FontWeight="Bold" Foreground="#2FBF71" LetterSpacing="1" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Name="TxtActiveSessionDetails" Text="Connected to Remote PC" FontSize="13" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                    <TextBlock Name="TxtActiveSessionSub" Text="Your session is running inside Microsoft Remote Desktop."
                               FontSize="12" Foreground="#9FC7A6" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Grid.Column="0" Name="BtnReturnToRdp" Content="Return to Remote Desktop" Background="#005FB8" Foreground="White" CornerRadius="4"
                                HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Name="BtnEndActiveSession" Content="End Session" Background="#B80000" Foreground="White" CornerRadius="4"
                                HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Backup reminder: the vault lives in the app sandbox, so uninstalling the app
                 destroys it permanently. Shown only when there are unbacked-up changes. -->
            <Border Grid.Row="2" Name="BannerBackupReminder" Background="#241C0C" BorderBrush="#5A431A" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" IsVisible="False">
                <StackPanel Spacing="8">
                    <TextBlock Text="⚠ THIS VAULT EXISTS ONLY ON THIS PHONE" FontSize="12" FontWeight="Bold" Foreground="#E8A030" LetterSpacing="1" TextWrapping="Wrap"/>
                    <TextBlock Text="Uninstalling RDP Vault, or resetting the phone, deletes your connections permanently. Export an encrypted backup now."
                               FontSize="12" Foreground="#D8CDB8" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,8,Auto">
                        <Button Grid.Column="0" Name="BtnBackupNow" Content="📤 Back up now" Background="#5A431A" Foreground="#FFE9C2" CornerRadius="4" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Name="BtnDismissBackupReminder" Content="Later" Background="Transparent" Foreground="#9A9AA3" FontSize="13"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Search / Filter Bar -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBox Grid.Column="0" Name="TxtSearch" Watermark="Search connections (name, host, user, notes)..."
                         Background="#141417" Foreground="#EDEDED" BorderBrush="#2E2E35" FontSize="14"/>
                <Button Grid.Column="1" Name="BtnClearSearch" Content="✕" Background="#141417" Foreground="#9A9AA3"
                        BorderBrush="#2E2E35" MinWidth="46" Margin="6,0,0,0"/>
            </Grid>

            <!-- Profiles List -->
            <ScrollViewer Grid.Row="4">
                <StackPanel Spacing="10">
                    <TextBlock Name="TxtEmptyProfiles" Text="No connections yet. Tap '+ Add' above to configure your first computer."
                               Foreground="#8A8A93" FontSize="13" HorizontalAlignment="Center" Margin="0,32,0,0" IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>
                    <StackPanel Name="PnlProfilesList" Spacing="10"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 6. PROFILE EDITOR ==================== -->
        <Grid Name="PanelProfileEditor" RowDefinitions="Auto,*" Margin="16,52,16,16" IsVisible="False">
            <!-- The ONLY Save / Cancel pair in this screen (audit item 10 / suggestion 5) -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                <Button Grid.Column="0" Name="BtnTopCancelProfile" Content="←" Background="#2E2E35" Foreground="#EDEDED"
                        MinWidth="46" CornerRadius="4" FontSize="18"/>
                <TextBlock Grid.Column="1" Name="TxtEditorTitle" Text="New Connection" FontSize="17" FontWeight="Bold"
                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Name="BtnTopSaveProfile" Content="Save" Background="#005FB8" Foreground="White"
                        Padding="20,8" CornerRadius="4" FontWeight="SemiBold"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Name="ScrollProfileEditor" HorizontalScrollBarVisibility="Disabled">
                <!-- Bottom padding is modest: windowSoftInputMode=adjustResize shrinks the
                     viewport and BringIntoView scrolls the focused field above the keyboard,
                     so the old fixed 400px dead zone is gone (suggestion 8). -->
                <StackPanel Margin="0,0,0,40" Spacing="14">
                    <!-- THE ESSENTIALS: everything needed to connect, nothing else -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="CONNECTION NAME" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <TextBox Name="TxtProfileName" Watermark="e.g. Office Desktop" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>

                            <TextBlock Text="HOST / IP ADDRESS" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <TextBox Name="TxtProfileHost" Watermark="e.g. 192.168.1.100 or mypc.ddns.net" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>

                            <TextBlock Text="PORT (DEFAULT 3389)" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <TextBox Name="TxtProfilePort" Text="3389" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>

                            <TextBlock Text="USERNAME" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <TextBox Name="TxtProfileUser" Watermark="e.g. Administrator or DOMAIN\User" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>

                            <TextBlock Text="PASSWORD" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Name="TxtProfilePass" PasswordChar="●" Watermark="Remote desktop password" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                                <!-- Reveal is available HERE ONLY, inside edit mode, by design.
                                     Connection cards, the launch overlay and Settings expose no
                                     way to read or copy a stored password. -->
                                <Button Grid.Column="1" Name="BtnToggleProfilePass" Content="👁" Background="#1C1C21" Foreground="#9A9AA3"
                                        BorderBrush="#2E2E35" MinWidth="48" Margin="6,0,0,0"/>
                            </Grid>
                            <TextBlock Text="Visible only while editing this connection. It is never shown on the connections list and is never copied to the clipboard."
                                       FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Advanced disclosure -->
                    <Button Name="BtnToggleAdvanced" Content="▸  Advanced options (display, wake-on-LAN, gateway, notes)"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="#1C1C21" Foreground="#C7C7D1" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="6" FontSize="13"/>

                    <StackPanel Name="PnlProfileAdvanced" Spacing="14" IsVisible="False">
                        <!-- Gateway -->
                        <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="RD GATEWAY SERVER (OPTIONAL)" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                                <TextBox Name="TxtProfileGateway" Watermark="e.g. gateway.company.com" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                                <TextBlock Text="Only needed if your workplace routes remote desktop through a gateway server. Leave empty for home PCs."
                                           FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Remote Display Resolution & Multi-Monitor Safety Card -->
                        <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="REMOTE DISPLAY &amp; MONITOR PROTECTION" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                                <TextBlock Text="Display Resolution Preset" FontSize="13" Foreground="#9A9AA3"/>
                                <ComboBox Name="CmbProfileResolution" HorizontalAlignment="Stretch" Background="#1C1C21" BorderBrush="#2E2E35" Foreground="#EDEDED">
                                    <ComboBoxItem Content="Default (Follow Global Vault Setting)"/>
                                    <ComboBoxItem Content="1920 x 1080 (1080p Full HD - Safe for Desktop Monitors)"/>
                                    <ComboBoxItem Content="1280 x 720 (720p HD - Bandwidth Saver)"/>
                                    <ComboBoxItem Content="1600 x 900 (900p HD+)"/>
                                    <ComboBoxItem Content="1366 x 768 (Standard Laptop)"/>
                                    <ComboBoxItem Content="2560 x 1440 (1440p 2K QHD)"/>
                                    <ComboBoxItem Content="3840 x 2160 (4K Ultra HD)"/>
                                    <ComboBoxItem Content="Match Mobile Device Screen"/>
                                    <ComboBoxItem Content="Custom Resolution..."/>
                                </ComboBox>

                                <Grid Name="PnlProfileCustomRes" ColumnDefinitions="*,10,*" IsVisible="False">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Width (pixels)" FontSize="12" Foreground="#9A9AA3"/>
                                        <TextBox Name="TxtProfileCustomWidth" Text="1920" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="Height (pixels)" FontSize="12" Foreground="#9A9AA3"/>
                                        <TextBox Name="TxtProfileCustomHeight" Text="1080" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Remote Multi-Monitor Mode" FontSize="13" Foreground="#9A9AA3" Margin="0,4,0,0"/>
                                <ComboBox Name="CmbProfileMultiMon" HorizontalAlignment="Stretch" Background="#1C1C21" BorderBrush="#2E2E35" Foreground="#EDEDED">
                                    <ComboBoxItem Content="Default (Follow Global Vault Setting)"/>
                                    <ComboBoxItem Content="Single Monitor Only (protects a multi-monitor PC)"/>
                                    <ComboBoxItem Content="Span All Remote Monitors"/>
                                </ComboBox>

                                <!-- Label text is rewritten at runtime to name the resolution the
                                     user actually picked (suggestion 2 / audit item 8). -->
                                <CheckBox Name="ChkProfilePreserveNative" Content="Keep native size (never squash or distort - scroll to view)" Foreground="#EDEDED" IsChecked="True"/>
                                <TextBlock Name="TxtProfilePreserveNativeHint" Text=""
                                           FontSize="12" Foreground="#2FBF71" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Wake-on-LAN Settings Card -->
                        <Border Name="CardWol" Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="WAKE-ON-LAN (REMOTE POWER ON)" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                                <CheckBox Name="ChkProfileEnableWol" Content="Send wake-up signal before connecting" Foreground="#EDEDED"/>
                                <StackPanel Name="PnlWolDetails" Spacing="10" IsVisible="False">
                                    <TextBlock Text="Wake-on-LAN only works while this phone is on the same Wi-Fi / wired network as the PC. It cannot work over mobile data."
                                               FontSize="12" Foreground="#E8A030" TextWrapping="Wrap"/>
                                    <TextBlock Text="MAC ADDRESS" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                                    <TextBox Name="TxtProfileWolMac" Watermark="AA:BB:CC:DD:EE:FF" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                                    <Grid ColumnDefinitions="*,10,*">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="WOL Port" FontSize="12" Foreground="#9A9AA3"/>
                                            <TextBox Name="TxtProfileWolPort" Text="9" Watermark="9" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Wait seconds" FontSize="12" Foreground="#9A9AA3"/>
                                            <TextBox Name="TxtProfileWolWait" Text="25" Watermark="25" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Security & Certificates Card -->
                        <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="SECURITY &amp; CERTIFICATES" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                                <CheckBox Name="ChkProfileSuppressCert" Content="Ignore certificate warnings (recommended for home/work networks)" Foreground="#EDEDED" IsChecked="True"/>
                            </StackPanel>
                        </Border>

                        <!-- Notes Card -->
                        <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="NOTES" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                                <TextBox Name="TxtProfileNotes" Watermark="Optional connection notes..." AcceptsReturn="True" MinHeight="72"
                                         VerticalContentAlignment="Top"
                                         Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Name="TxtProfileError" Foreground="#FF6B6B" FontSize="13" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>

                    <Button Name="BtnDeleteProfile" Content="🗑 Delete Connection" Background="#B80000" Foreground="White"
                            HorizontalAlignment="Stretch" CornerRadius="6" IsVisible="False" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 7. SETTINGS PANEL ==================== -->
        <Grid Name="PanelSettings" RowDefinitions="Auto,*" Margin="16,52,16,16" IsVisible="False">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                <Button Grid.Column="0" Name="BtnTopCloseSettings" Content="← Back" Background="#2E2E35" Foreground="#EDEDED"
                        Padding="14,8" CornerRadius="4"/>
                <TextBlock Grid.Column="1" Text="Vault Settings" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,40" Spacing="16">
                    <!-- Privacy / screen capture -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="SCREEN PRIVACY" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <TextBlock Text="By default RDP Vault blocks screenshots and screen recording, and shows a blank card in the Android app switcher so nobody can read your computer list over your shoulder."
                                       FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                            <CheckBox Name="ChkSettingsAllowScreenshots" Content="Allow screenshots and screen recording (not recommended)" Foreground="#EDEDED"/>
                        </StackPanel>
                    </Border>

                    <!-- Biometric Hardware Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="DEVICE BIOMETRICS (FINGERPRINT / FACE UNLOCK)" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <TextBlock Name="TxtBiometricStatus" Text="Biometrics: Not enrolled" FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>
                            <Button Name="BtnToggleBiometrics" Content="Enroll Biometrics" Background="#005FB8" Foreground="White"
                                    CornerRadius="6" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="The master key is sealed inside this phone's security chip and is released only by a Class 3 fingerprint or face check. Enrolling a new fingerprint in Android cancels the seal on purpose - unlock once with your master password to rebuild it."
                                       FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Auto-Lock Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="AUTO-LOCK" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <TextBlock Text="Lock the vault after this much time with nobody touching the screen. This now applies while the app is open and on-screen, not only after it is minimised."
                                       FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                            <ComboBox Name="CmbSettingsAutoLock" HorizontalAlignment="Stretch" Background="#1C1C21" BorderBrush="#2E2E35" Foreground="#EDEDED">
                                <ComboBoxItem Content="1 minute (Recommended)"/>
                                <ComboBoxItem Content="5 minutes"/>
                                <ComboBoxItem Content="15 minutes"/>
                                <ComboBoxItem Content="30 minutes"/>
                                <ComboBoxItem Content="60 minutes"/>
                                <ComboBoxItem Content="Never"/>
                            </ComboBox>
                            <CheckBox Name="ChkSettingsLockOnBackground" Content="Also lock the instant the app leaves the screen" Foreground="#EDEDED" IsChecked="True"/>
                            <TextBlock Text="A running remote session never triggers auto-lock, and opening a file picker or Remote Desktop does not count as leaving."
                                       FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Remote Display & Resolution Defaults -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="REMOTE DISPLAY &amp; RESOLUTION DEFAULTS" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <TextBlock Text="Default Display Resolution" FontSize="13" Foreground="#9A9AA3"/>
                            <ComboBox Name="CmbSettingsResolution" HorizontalAlignment="Stretch" Background="#1C1C21" BorderBrush="#2E2E35" Foreground="#EDEDED">
                                <ComboBoxItem Content="1920 x 1080 (1080p Full HD - Safe for Desktop Monitors)"/>
                                <ComboBoxItem Content="1280 x 720 (720p HD - Bandwidth Saver)"/>
                                <ComboBoxItem Content="1600 x 900 (900p HD+)"/>
                                <ComboBoxItem Content="1366 x 768 (Standard Laptop)"/>
                                <ComboBoxItem Content="2560 x 1440 (1440p 2K QHD)"/>
                                <ComboBoxItem Content="3840 x 2160 (4K Ultra HD)"/>
                                <ComboBoxItem Content="Match Mobile Device Screen"/>
                            </ComboBox>

                            <TextBlock Text="Remote Multi-Monitor Safety Mode" FontSize="13" Foreground="#9A9AA3" Margin="0,4,0,0"/>
                            <ComboBox Name="CmbSettingsMultiMon" HorizontalAlignment="Stretch" Background="#1C1C21" BorderBrush="#2E2E35" Foreground="#EDEDED">
                                <ComboBoxItem Content="Single Monitor Only (Recommended)"/>
                                <ComboBoxItem Content="Use All Remote Displays (Span all monitors)"/>
                            </ComboBox>

                            <CheckBox Name="ChkSettingsPreserveNative" Content="Keep native size by default (never squash or distort - scroll to view)" Foreground="#EDEDED" IsChecked="True"/>
                            <TextBlock Name="TxtSettingsPreserveNativeHint" Text=""
                                       FontSize="12" Foreground="#2FBF71" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Auto-Type Password Injector Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="AUTO-TYPE PASSWORD INJECTION" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <TextBlock Text="Types the saved password straight into Microsoft Remote Desktop for you. Nothing is placed on the clipboard and nothing is saved inside Remote Desktop."
                                       FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                            <TextBlock Name="TxtAccessibilityStatus" Text="Checking status..." FontSize="13" Foreground="#2FBF71" TextWrapping="Wrap"/>

                            <Border Name="CardAccessibilityGuide" Background="#1A1813" BorderBrush="#664D03" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="HOW TO TURN IT ON" FontSize="12" FontWeight="Bold" Foreground="#FFC107" LetterSpacing="1"/>
                                    <TextBlock Text="1. Tap Open Accessibility below, then pick 'RDP Vault Auto-Type'.&#x0a;2. If the switch is greyed out, tap 'Unlock App Settings', then the ⋮ menu, then 'Allow restricted settings'.&#x0a;3. Go back to Accessibility and turn the switch on."
                                               FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid ColumnDefinitions="*,10,*">
                                <Button Grid.Column="0" Name="BtnSettingsAccessibility" Content="⚙ Open Accessibility" Background="#005FB8" Foreground="White"
                                        CornerRadius="6" HorizontalAlignment="Stretch" FontWeight="SemiBold" FontSize="13"/>
                                <Button Grid.Column="2" Name="BtnSettingsAppInfo" Content="🔓 Unlock App Settings" Background="#2E2E35" Foreground="#FFC107"
                                        CornerRadius="6" HorizontalAlignment="Stretch" FontSize="13"/>
                            </Grid>

                            <Button Name="BtnResetAutoTypePrompt" Content="Show the Auto-Type prompt again when connecting"
                                    Background="Transparent" Foreground="#9A9AA3" FontSize="13" HorizontalAlignment="Stretch" IsVisible="False"/>
                        </StackPanel>
                    </Border>

                    <!-- Vault Backup & File Transfer Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="VAULT BACKUP &amp; FILE TRANSFER" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <TextBlock Text="Your vault lives inside this app only. Uninstalling RDP Vault or resetting the phone destroys it. The backup file is the same encrypted vault - it is useless to anyone without your master password."
                                       FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                            <Button Name="BtnShareVault" Content="📤 Share backup (Quick Share, Drive, email...)" Background="#005FB8" Foreground="White"
                                    CornerRadius="6" HorizontalAlignment="Stretch" FontWeight="SemiBold" FontSize="13"/>
                            <Grid ColumnDefinitions="*,10,*">
                                <Button Grid.Column="0" Name="BtnExportVault" Content="💾 Save to file" Background="#2E2E35" Foreground="#EDEDED"
                                        CornerRadius="6" HorizontalAlignment="Stretch" FontSize="13"/>
                                <Button Grid.Column="2" Name="BtnImportVault" Content="📥 Restore backup" Background="#2E2E35" Foreground="#EDEDED"
                                        CornerRadius="6" HorizontalAlignment="Stretch" FontSize="13"/>
                            </Grid>
                            <TextBlock Name="TxtVaultBackupStatus" Text="" FontSize="13" Foreground="#2FBF71" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Recovery Code Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="EMERGENCY RECOVERY CODE" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <TextBlock Text="Your recovery code is sealed inside the vault and cannot be read back. If you lost it, generate a fresh one - the old code stops working immediately."
                                       FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                            <Button Name="BtnRegenerateRecoveryCode" Content="Generate Fresh Recovery Code" Background="#2E2E35" Foreground="#EDEDED"
                                    CornerRadius="6" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Change Master Password Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="CHANGE MASTER PASSWORD" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Name="TxtSettingsCurrentPass" PasswordChar="●" Watermark="Current master password..."
                                         Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                                <Button Grid.Column="1" Name="BtnToggleSettingsCurrentPass" Content="👁" Background="#1C1C21" Foreground="#9A9AA3"
                                         BorderBrush="#2E2E35" MinWidth="48" Margin="6,0,0,0"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Name="TxtSettingsNewPass" PasswordChar="●" Watermark="New master password (min 8 chars)..."
                                         Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                                <Button Grid.Column="1" Name="BtnToggleSettingsNewPass" Content="👁" Background="#1C1C21" Foreground="#9A9AA3"
                                         BorderBrush="#2E2E35" MinWidth="48" Margin="6,0,0,0"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Name="TxtSettingsConfirmPass" PasswordChar="●" Watermark="Confirm new master password..."
                                         Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                                <Button Grid.Column="1" Name="BtnToggleSettingsConfirmPass" Content="👁" Background="#1C1C21" Foreground="#9A9AA3"
                                         BorderBrush="#2E2E35" MinWidth="48" Margin="6,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Changing the master password also issues a brand new recovery code. Your old recovery code stops working."
                                       FontSize="12" Foreground="#E8A030" TextWrapping="Wrap"/>

                            <TextBlock Name="TxtChangePasswordError" Foreground="#FF6B6B" FontSize="13" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>

                            <Button Name="BtnChangeMasterPassword" Content="Update Master Password" Background="#2E2E35" Foreground="#EDEDED"
                                    CornerRadius="6" HorizontalAlignment="Stretch"/>

                            <StackPanel Name="PnlChangePassProgress" Spacing="6" Margin="0,4,0,0" IsVisible="False">
                                <ProgressBar IsIndeterminate="True" Height="4" Foreground="#005FB8" Background="#1C1C21"/>
                                <TextBlock Text="Updating master password..." FontSize="13" Foreground="#8A8A93" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- General Connection & Security Defaults Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="CONNECTION &amp; SECURITY DEFAULTS" FontSize="12" FontWeight="Bold" Foreground="#9A9AA3" LetterSpacing="1"/>
                            <CheckBox Name="ChkSettingsSuppressCert" Content="Ignore certificate warnings by default (recommended for private/home networks)" Foreground="#EDEDED" IsChecked="True"/>
                            <CheckBox Name="ChkSettingsPreflight" Content="Check the PC is awake before opening Remote Desktop" Foreground="#EDEDED" IsChecked="True"/>
                            <TextBlock Text="A one-second check that saves you from Remote Desktop's 30-second spinner and its '0x204' error when the PC is simply asleep."
                                       FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Name="TxtSettingsVersion" Text="" FontSize="12" Foreground="#6A6A73" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 8. MODALS & OVERLAYS ==================== -->

        <!-- Tactical Launch & WOL Progress Overlay -->
        <Border Name="OverlayLaunch" Background="#E00A0A0C" IsVisible="False" ZIndex="200">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Name="TxtLaunchTitle" Text="CONNECTING TO REMOTE COMPUTER" FontSize="15" FontWeight="Bold"
                                   Foreground="#EDEDED" LetterSpacing="1" TextWrapping="Wrap"/>
                        <TextBlock Name="TxtLaunchTarget" Text="Target Host" FontSize="13" Foreground="#9A9AA3" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <ProgressBar Name="ProgLaunch" Height="6" CornerRadius="3" Foreground="#005FB8" Background="#24242A"
                                     IsIndeterminate="True" Minimum="0" Maximum="100"/>
                        <TextBlock Name="TxtLaunchCountdown" Text="" FontSize="12" Foreground="#8AB4F8"
                                   HorizontalAlignment="Right" IsVisible="False"/>
                    </StackPanel>

                    <Border Background="#0E0E10" BorderBrush="#24242A" BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="▶ " FontSize="13" Foreground="#007AE8" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Name="TxtLaunchStep" Text="Connecting..."
                                       FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Host unreachable pre-flight result (suggestion 10) -->
                    <Border Name="CardLaunchUnreachable" Background="#2A1212" BorderBrush="#7A2A2A" BorderThickness="1" CornerRadius="4" Padding="12,10" IsVisible="False">
                        <StackPanel Spacing="8">
                            <TextBlock Name="TxtLaunchUnreachableTitle" Text="HOST NOT RESPONDING" FontSize="12" FontWeight="Bold" Foreground="#FF8A8A" LetterSpacing="1" TextWrapping="Wrap"/>
                            <TextBlock Name="TxtLaunchUnreachableBody" Text="" FontSize="13" Foreground="#F0C9C9" TextWrapping="Wrap"/>
                            <Button Name="BtnLaunchSendWol" Content="⚡ Send Wake-on-LAN signal" Background="#5A2A2A" Foreground="#FFE0E0"
                                    CornerRadius="4" HorizontalAlignment="Stretch" FontSize="13" IsVisible="False"/>
                            <Grid ColumnDefinitions="*,8,*">
                                <Button Grid.Column="0" Name="BtnLaunchRetryProbe" Content="Check again" Background="#2E2E35" Foreground="#EDEDED"
                                        CornerRadius="4" HorizontalAlignment="Stretch" FontSize="13"/>
                                <Button Grid.Column="2" Name="BtnLaunchConnectAnyway" Content="Connect anyway" Background="#005FB8" Foreground="White"
                                        CornerRadius="4" HorizontalAlignment="Stretch" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Auto-Type / Credential notice -->
                    <Border Name="CardLaunchPasswordTip" Background="#18181D" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="4" Padding="10,8" IsVisible="False">
                        <StackPanel Spacing="2">
                            <TextBlock Name="TxtLaunchPasswordTipTitle" Text="ZERO-CLIPBOARD AUTO-TYPE" FontSize="12" FontWeight="Bold" Foreground="#8AB4F8" TextWrapping="Wrap"/>
                            <TextBlock Name="TxtLaunchPasswordTipBody" Text="" FontSize="12" Foreground="#2FBF71" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Screen Scroll & Pan Guidance -->
                    <Border Name="CardLaunchPanTip" Background="#141417" BorderBrush="#24242A" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="💡 " FontSize="13" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Name="TxtLaunchPanTip" Text=""
                                       FontSize="12" Foreground="#8AB4F8" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Name="TxtLaunchSubStatus" Text="" FontSize="12" Foreground="#2FBF71" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,8,*">
                            <Button Grid.Column="0" Name="BtnSkipWolWait" Content="Skip countdown &amp; connect now" Background="#005FB8" Foreground="White"
                                    CornerRadius="4" HorizontalAlignment="Stretch" FontSize="13" IsVisible="False"/>
                            <Button Grid.Column="2" Name="BtnCancelLaunch" Content="Cancel" Background="#2E2E35" Foreground="#EDEDED"
                                    CornerRadius="4" HorizontalAlignment="Stretch" FontSize="13"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Delete Confirmation Modal Overlay -->
        <Border Name="OverlayConfirmDelete" Background="#E00A0A0C" IsVisible="False" ZIndex="250">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Delete Connection?" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                    <TextBlock Name="TxtConfirmDeleteMessage" Text="Are you sure you want to delete this connection? This cannot be undone."
                               FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,10,*">
                        <Button Grid.Column="0" Name="BtnCancelDelete" Content="Cancel" Background="#2E2E35" Foreground="#EDEDED"
                                CornerRadius="6" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Name="BtnConfirmDelete" Content="Delete" Background="#B80000" Foreground="White"
                                CornerRadius="6" HorizontalAlignment="Stretch" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Discard Changes Confirmation Modal Overlay -->
        <Border Name="OverlayConfirmDiscardProfile" Background="#E00A0A0C" IsVisible="False" ZIndex="250">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Discard Unsaved Changes?" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                    <TextBlock Text="You have unsaved changes to this connection. If you leave now, all your edits will be discarded."
                               FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,10,*">
                        <Button Grid.Column="0" Name="BtnKeepEditingProfile" Content="Keep Editing" Background="#005FB8" Foreground="White"
                                CornerRadius="6" HorizontalAlignment="Stretch" FontWeight="SemiBold"/>
                        <Button Grid.Column="2" Name="BtnConfirmDiscardProfile" Content="Discard" Background="#B80000" Foreground="White"
                                CornerRadius="6" HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Restore Vault Backup Confirmation Modal Overlay -->
        <Border Name="OverlayConfirmRestoreVault" Background="#E00A0A0C" IsVisible="False" ZIndex="250">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Restore Vault Backup?" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                    <TextBlock Name="TxtConfirmRestoreMessage" Text="Restoring from a backup file will replace all current connections and settings on this device. A backup (.bak) of your current vault will be saved. Continue?"
                               FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,10,*">
                        <Button Grid.Column="0" Name="BtnCancelRestoreVault" Content="Cancel" Background="#2E2E35" Foreground="#EDEDED"
                                CornerRadius="6" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Name="BtnConfirmRestoreVault" Content="Restore &amp; Replace" Background="#005FB8" Foreground="White"
                                CornerRadius="6" HorizontalAlignment="Stretch" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Password Verification Modal for Generating Fresh Recovery Code -->
        <Border Name="OverlayPromptPasswordForRecovery" Background="#E00A0A0C" IsVisible="False" ZIndex="250">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Generate a new recovery code?" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                    <Border Background="#2A1F0A" BorderBrush="#5A431A" BorderThickness="1" CornerRadius="6" Padding="12">
                        <TextBlock Text="Your current recovery code will stop working the moment the new one is created. If you have it written down somewhere, that copy becomes useless."
                                   FontSize="13" Foreground="#E8A030" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="Enter your master password to continue:"
                               FontSize="13" Foreground="#9A9AA3" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Name="TxtVerifyPassForRecovery" PasswordChar="●" Watermark="Master password..."
                                 Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                        <Button Grid.Column="1" Name="BtnToggleVerifyRecoveryPass" Content="👁" Background="#1C1C21" Foreground="#9A9AA3"
                                BorderBrush="#2E2E35" MinWidth="48" Margin="6,0,0,0"/>
                    </Grid>
                    <TextBlock Name="TxtVerifyPassForRecoveryError" Foreground="#FF6B6B" FontSize="13" IsVisible="False" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,10,*">
                        <Button Grid.Column="0" Name="BtnCancelVerifyPassForRecovery" Content="Cancel" Background="#2E2E35" Foreground="#EDEDED"
                                CornerRadius="6" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Name="BtnSubmitVerifyPassForRecovery" Content="Generate Code" Background="#005FB8" Foreground="White"
                                CornerRadius="6" HorizontalAlignment="Stretch" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Enable Accessibility Auto-Type Modal Overlay -->
        <Border Name="OverlayEnableAccessibility" Background="#E00A0A0C" IsVisible="False" ZIndex="260">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="🔒 TYPE MY PASSWORD FOR ME" FontSize="12" FontWeight="Bold" Foreground="#8AB4F8" LetterSpacing="1" TextWrapping="Wrap"/>
                        <TextBlock Text="Turn on Auto-Type?" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="RDP Vault can type your saved password straight into Microsoft Remote Desktop. Nothing goes on the clipboard and nothing is stored inside Remote Desktop. Turning it on is a one-time trip to Android Settings."
                               FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>

                    <Border Background="#1A1813" BorderBrush="#664D03" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="IF THE SWITCH IS GREYED OUT" FontSize="12" FontWeight="Bold" Foreground="#FFC107" LetterSpacing="1"/>
                            <TextBlock Text="Tap 'Unlock App Settings' below, then the ⋮ menu, then 'Allow restricted settings'. Then come back to Accessibility and turn it on."
                                       FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <Button Name="BtnOpenAccessibilitySettings" Content="⚙ Open Accessibility Settings" Background="#005FB8" Foreground="White"
                                CornerRadius="6" HorizontalAlignment="Stretch" FontWeight="SemiBold"/>
                        <Button Name="BtnOpenAppInfo" Content="🔓 Unlock App Settings (if greyed out)" Background="#2E2E35" Foreground="#FFC107"
                                CornerRadius="6" HorizontalAlignment="Stretch" FontSize="13"/>
                        <Button Name="BtnContinueWithoutAccessibility" Content="No thanks - I'll type it myself" Background="#1C1C21" Foreground="#EDEDED"
                                BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch" FontSize="13"/>
                        <CheckBox Name="ChkDontAskAccessibilityAgain" Content="Don't ask me again" Foreground="#9A9AA3"/>
                        <Button Name="BtnCancelAccessibilityPrompt" Content="Cancel connection" Background="Transparent" Foreground="#9A9AA3"
                                CornerRadius="6" HorizontalAlignment="Stretch" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- End Session explainer (audit item 2 / Finding 2) -->
        <Border Name="OverlayEndSession" Background="#E00A0A0C" IsVisible="False" ZIndex="260">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="End this remote session?" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                    <TextBlock Text="Your session is running inside Microsoft Remote Desktop, not inside RDP Vault. Android does not let one app disconnect another app's session, so the only way to truly sign out is to do it in Remote Desktop itself."
                               FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>
                    <StackPanel Spacing="8">
                        <Button Name="BtnEndSessionOpenRdp" Content="Open Remote Desktop and disconnect there" Background="#005FB8" Foreground="White"
                                CornerRadius="6" HorizontalAlignment="Stretch" FontWeight="SemiBold" FontSize="13"/>
                        <Button Name="BtnEndSessionStopTracking" Content="Just stop tracking it here" Background="#2E2E35" Foreground="#EDEDED"
                                CornerRadius="6" HorizontalAlignment="Stretch" FontSize="13"/>
                        <Button Name="BtnEndSessionCancel" Content="Cancel" Background="Transparent" Foreground="#9A9AA3"
                                CornerRadius="6" HorizontalAlignment="Stretch" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Biometric seal repair (Finding 3): explicit consent, never silent -->
        <Border Name="OverlayRepairBiometrics" Background="#E00A0A0C" IsVisible="False" ZIndex="260">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Fingerprint unlock stopped working" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                    <TextBlock Name="TxtRepairBiometricsBody"
                               Text="This normally means a new fingerprint or face was added to the phone, or Android was updated. For your safety the old seal was destroyed rather than quietly extended to the new fingerprint. Re-create it now?"
                               FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,10,*">
                        <Button Grid.Column="0" Name="BtnSkipRepairBiometrics" Content="Not now" Background="#2E2E35" Foreground="#EDEDED"
                                CornerRadius="6" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Name="BtnDoRepairBiometrics" Content="Re-create seal" Background="#005FB8" Foreground="White"
                                CornerRadius="6" HorizontalAlignment="Stretch" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
