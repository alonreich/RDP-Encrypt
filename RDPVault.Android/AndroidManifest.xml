<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.rdpvault.app"
          android:versionCode="1"
          android:versionName="1.1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- Network permissions for RDP socket connections and Wake-on-LAN -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Hardware-backed security: Mobile TPM equivalent via BiometricPrompt -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Foreground Service & Session Continuity across Screen Flips -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Intent and package visibility for external RDP client handoff and Play Store fallback -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="rdp" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <package android:name="com.microsoft.rdc.androidx" />
        <package android:name="com.microsoft.rdc.android" />
        <package android:name="com.iiordanov.freeaRDP" />
        <package android:name="com.iiordanov.aRDP" />
    </queries>

    <application
        android:label="RDP Vault"
        android:icon="@mipmap/icon"
        android:roundIcon="@mipmap/icon"
        android:allowBackup="false"
        android:theme="@style/MainTheme">
    </application>
</manifest>
