<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RDPVault.ProfileEditorWindow"
        Title="Edit Profile" Width="460" Height="720"
        Icon="avares://RDPVault/Assets/icon.ico"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="#0E0E10" Foreground="#EDEDED" FontFamily="Inter, Arial">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#141417"/>
            <Setter Property="BorderBrush" Value="#2E2E35"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="#005FB8"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#2E2E35"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A30"/>
        </Style>
        <Style Selector="Button.Accent">
            <Setter Property="Background" Value="#005FB8"/>
            <Setter Property="BorderBrush" Value="#006CD0"/>
        </Style>
        <Style Selector="Button.Accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#006CD0"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#EDEDED"/>
        </Style>
    </Window.Styles>

    <ScrollViewer>
    <StackPanel Margin="24" Spacing="10">
        <TextBlock Text="PROFILE SETTINGS" FontSize="18" FontWeight="Bold" LetterSpacing="1" Margin="0,0,0,6"/>

        <TextBlock Text="Display name" FontSize="13" Foreground="#8A8A93"/>
        <TextBox Name="TxtName" Watermark="e.g. Production Server"/>

        <Grid ColumnDefinitions="*,10,110">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Host / IP address" FontSize="13" Foreground="#8A8A93"/>
                <TextBox Name="TxtHost" Watermark="e.g. 192.168.1.100"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Port" FontSize="13" Foreground="#8A8A93"/>
                <TextBox Name="TxtPort" Watermark="3389"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Username" FontSize="13" Foreground="#8A8A93"/>
        <TextBox Name="TxtUsername" Watermark="Administrator"/>

        <TextBlock Text="Password (leave empty to be asked at connect time)" FontSize="13" Foreground="#8A8A93"/>
        <TextBox Name="TxtPassword" PasswordChar="•" Watermark="Password"/>
        <CheckBox Name="ChkShowPassword" Content="Show password" FontSize="12" Click="ChkShowPassword_Click"/>

        <TextBlock Text="RD Gateway host (optional)" FontSize="13" Foreground="#8A8A93" Margin="0,6,0,0"/>
        <TextBox Name="TxtGateway" Watermark="gateway.example.com"/>

        <TextBlock Text="Display resolution" FontSize="13" Foreground="#8A8A93" Margin="0,6,0,0"/>
        <ComboBox Name="CmbResolution" HorizontalAlignment="Stretch" Background="#141417"
                  BorderBrush="#2E2E35" Foreground="#EDEDED">
            <ComboBoxItem Content="Full screen"/>
            <ComboBoxItem Content="Use all monitors (multi-monitor)"/>
            <ComboBoxItem Content="1920 x 1080"/>
            <ComboBoxItem Content="1600 x 900"/>
            <ComboBoxItem Content="1366 x 768"/>
            <ComboBoxItem Content="1280 x 1024"/>
            <ComboBoxItem Content="1280 x 800"/>
            <ComboBoxItem Content="1024 x 768"/>
            <ComboBoxItem Content="800 x 600"/>
        </ComboBox>

        <TextBlock Text="Local resources to share with the remote PC" FontSize="13" FontWeight="Bold"
                   Foreground="#8A8A93" Margin="0,10,0,0"/>
        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
            <CheckBox Name="ChkClipboard" Content="Clipboard" Margin="0,0,15,5"/>
            <CheckBox Name="ChkDrives" Content="Drives" Margin="0,0,15,5"/>
            <CheckBox Name="ChkPrinters" Content="Printers" Margin="0,0,15,5"/>
            <CheckBox Name="ChkSmartCards" Content="Smart cards" Margin="0,0,15,5"/>
        </WrapPanel>

        <Border Background="#121215" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="4"
                Padding="10" Margin="0,8,0,0">
            <StackPanel Spacing="4">
                <CheckBox Name="ChkAllowUnverified">
                    <TextBlock Text="Skip the certificate warning for this host"
                               TextWrapping="Wrap" Foreground="#EDEDED"/>
                </CheckBox>
                <TextBlock Text="On by default. Most RDP hosts use a self-signed certificate, and RDP Vault erases the registry entry where Windows remembers &quot;don't ask me again&quot; - so leaving this off means a warning on every single connection. Untick it only for a host with a properly issued certificate, where you want the connection stopped if its identity ever fails to check out."
                           FontSize="11" Foreground="#8A8A93" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Name="TxtError" Foreground="#E83030" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
            <Button Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"/>
            <Button Name="BtnSave" Content="Save Profile" Classes="Accent" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
