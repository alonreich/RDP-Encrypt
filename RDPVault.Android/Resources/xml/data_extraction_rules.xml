<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : explicitly forbid cloud backup and device-to-device transfer
     of the vault. The encrypted vault must move only through the user's own
     deliberate "Export / Share Backup" action. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
