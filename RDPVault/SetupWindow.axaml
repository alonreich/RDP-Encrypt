<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RDPVault.SetupWindow"
        Title="RDP Vault Setup" Width="550" Height="400"
        Icon="avares://RDPVault/Assets/icon.ico"
        WindowStartupLocation="CenterScreen" CanResize="False"
        Background="#0E0E10" Foreground="#EDEDED" FontFamily="Inter, Arial"
        Topmost="True">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#2E2E35"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A30"/>
        </Style>
        <Style Selector="Button.Accent">
            <Setter Property="Background" Value="#005FB8"/>
            <Setter Property="BorderBrush" Value="#006CD0"/>
        </Style>
        <Style Selector="Button.Accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#006CD0"/>
        </Style>
    </Window.Styles>

    <Grid Margin="30">
        <!-- MODE SELECTION PANEL -->
        <StackPanel Name="PnlSelection" Spacing="20" VerticalAlignment="Center">
            <TextBlock Text="WELCOME TO RDP VAULT" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" LetterSpacing="2"/>
            <TextBlock Text="How would you like to run the application?" FontSize="14" Foreground="#8A8A93" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            
            <Grid ColumnDefinitions="*,20,*">
                <Button Grid.Column="0" Name="BtnInstall" Classes="Accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="BtnInstall_Click">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Install to this PC" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Registers shortcuts and uninstaller" FontSize="11" Foreground="#A0C0E0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button Grid.Column="2" Name="BtnPortable" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="BtnPortable_Click">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Run Portably" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ideal for USB drives (No traces)" FontSize="11" Foreground="#8A8A93" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- PROGRESS PANEL -->
        <StackPanel Name="PnlProgress" Spacing="16" VerticalAlignment="Center" IsVisible="False">
            <TextBlock Text="INSTALLING RDP VAULT" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" LetterSpacing="1"/>
            <Border Background="#121215" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="4" Height="200" Padding="10">
                <ScrollViewer Name="ScrollLog">
                    <TextBlock Name="TxtLog" FontSize="12" FontFamily="Consolas" Foreground="#8A8A93" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
            <ProgressBar Name="ProgInstall" IsIndeterminate="True" Height="4" Margin="0,10,0,0" Foreground="#005FB8"/>
            <Button Name="BtnFinish" Content="Launch RDP Vault" Classes="Accent" HorizontalAlignment="Center" IsVisible="False" Click="BtnFinish_Click"/>
        </StackPanel>
    </Grid>
</Window>
