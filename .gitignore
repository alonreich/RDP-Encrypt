# Build output ---------------------------------------------------------------
# The shipped binaries live on GitHub Releases, never in the git repo.
[Bb]in/
[Oo]bj/
compiled/
publish/
artifacts/

# Logs & diagnostic dumps ---------------------------------------------------
*.log
build.log
build-apk.log
rdpvault.log
TestResults/
testresults/

# Local developer scratchpads & AI outputs -----------------------------------
Claude outputs/
[Cc]laude [Oo]utputs/
scratch/
.system_generated/
*.tmp
*.bak

# Python bytecode caches -----------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# Visual Studio / Rider / VS Code --------------------------------------------
.vs/
.idea/
.vscode/
*.user
*.suo
*.userprefs
*.workspace

# NuGet ----------------------------------------------------------------------
*.nupkg
packages/

# Runtime data that must NEVER be committed ----------------------------------
# A vault, its rolling backup, and failure counters belong to the user.
vault.rdpv
vault.rdpv.bak
vault.rdpv.tmp
rdpvault_fails.json
*.rdpvlink

# OS noise -------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
