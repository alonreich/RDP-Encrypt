<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RDPVault.UninstallWindow"
        Title="RDP Vault Uninstaller" Width="550" Height="400"
        Icon="avares://RDPVault/Assets/icon.ico"
        WindowStartupLocation="CenterScreen" CanResize="False"
        Background="#0E0E10" Foreground="#EDEDED" FontFamily="Inter, Arial"
        Topmost="True">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#2E2E35"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A30"/>
        </Style>
        <Style Selector="Button.Accent">
            <Setter Property="Background" Value="#005FB8"/>
            <Setter Property="BorderBrush" Value="#006CD0"/>
        </Style>
        <Style Selector="Button.Accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#006CD0"/>
        </Style>
    </Window.Styles>

    <Grid Margin="30">
        <!-- PROGRESS PANEL -->
        <StackPanel Name="PnlProgress" Spacing="16" VerticalAlignment="Center">
            <TextBlock Text="UNINSTALLING RDP VAULT" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" LetterSpacing="1" Foreground="IndianRed"/>
            <Border Background="#121215" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="4" Height="200" Padding="10">
                <ScrollViewer Name="ScrollLog">
                    <TextBlock Name="TxtLog" FontSize="12" FontFamily="Consolas" Foreground="#8A8A93" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
            <ProgressBar Name="ProgInstall" IsIndeterminate="True" Height="4" Margin="0,10,0,0" Foreground="IndianRed"/>
        </StackPanel>
    </Grid>
</Window>
