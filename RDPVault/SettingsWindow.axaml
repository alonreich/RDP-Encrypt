<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RDPVault.SettingsWindow"
        Title="Settings" Width="500" Height="650"
        Icon="avares://RDPVault/Assets/icon.ico"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="#0E0E10" Foreground="#EDEDED" FontFamily="Inter, Arial">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#141417"/>
            <Setter Property="BorderBrush" Value="#2E2E35"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="#005FB8"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#2E2E35"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A30"/>
        </Style>
        <Style Selector="Button.Accent">
            <Setter Property="Background" Value="#005FB8"/>
            <Setter Property="BorderBrush" Value="#006CD0"/>
        </Style>
        <Style Selector="Button.Accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#006CD0"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Window.Styles>
    
    <StackPanel Margin="24" Spacing="16">
        <TextBlock Text="VAULT SETTINGS" FontSize="18" FontWeight="Bold" LetterSpacing="1" Margin="0,0,0,10"/>
        
        <StackPanel Spacing="6">
            <TextBlock Text="Auto-lock Timer (Minutes)" FontSize="13" Foreground="#8A8A93"/>
            <TextBox Name="TxtLockMinutes" Watermark="e.g. 15"/>
            
            <TextBlock Text="Self-Destruct Trigger (Failed Attempts)" FontSize="13" Foreground="#8A8A93" Margin="0,10,0,0"/>
            <TextBox Name="TxtSelfDestructAttempts" Watermark="e.g. 10"/>
            
            <TextBlock Text="Self-Destruct Rolling Window (Minutes)" FontSize="13" Foreground="#8A8A93" Margin="0,10,0,0"/>
            <TextBox Name="TxtSelfDestructWindow" Watermark="e.g. 60"/>
        </StackPanel>

        <Border Height="1" Background="#1A1A1E" Margin="0,10"/>
        
        <StackPanel Spacing="4">
            <CheckBox Name="ChkKillSessions" Content="Kill Active RDP sessions when USB is physically removed"/>
            <CheckBox Name="ChkForceMultiMon" Content="Globally force Multi-Monitor for all profiles"/>
            <CheckBox Name="ChkEnforceBitLocker" Content="Enforce BitLocker validation on host machine (Anti-DPAPI)"/>
            <CheckBox Name="ChkRequireFido2" Content="Require FIDO2 Hardware Key presence"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"/>
            <Button Name="BtnSave" Content="Save Settings" Classes="Accent" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
