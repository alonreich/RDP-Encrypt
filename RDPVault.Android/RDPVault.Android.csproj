<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <ApplicationId>com.rdpvault.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <RootNamespace>RDPVault.Android</RootNamespace>
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <WarningsNotAsErrors>NETSDK1202;XA0141</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and Exists('$(MSBuildThisFileDirectory)rdpvault-release.keystore')">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)rdpvault-release.keystore</AndroidSigningKeyStore>
    <AndroidSigningStorePass>RdpVaultReleasePass2026!</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>rdpvault</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>RdpVaultReleasePass2026!</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RDPVault.Core\RDPVault.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Android" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.33" />
  </ItemGroup>
</Project>
