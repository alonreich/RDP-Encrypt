<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RDPVault.Android.Views.MainView"
             Background="#0E0E10"
             Foreground="#EDEDED">

    <Grid>
        <!-- ==================== 1. FIRST-TIME SETUP WIZARD ==================== -->
        <ScrollViewer Name="PanelFirstRun" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,54,24,32" Spacing="16">
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="0,8,0,12">
                    <TextBlock Text="RDP VAULT" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" LetterSpacing="2"/>
                    <TextBlock Text="Initial Vault Setup" FontSize="16" FontWeight="SemiBold" Foreground="#26A0DA" HorizontalAlignment="Center"/>
                    <TextBlock Text="Welcome! Create a secure master vault to protect your remote connections." FontSize="13" Foreground="#8A8A93" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Master Password Card -->
                <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="CREATE MASTER PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="TxtFirstRunPass" PasswordChar="●" Watermark="Master password (min 8 characters)..."
                                     Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="44" FontSize="14"/>
                            <Button Grid.Column="1" Name="BtnToggleFirstRunPass" Content="👁" Background="#1C1C21" Foreground="#8A8A93"
                                    BorderBrush="#2E2E35" Height="44" Width="44" Margin="4,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="TxtFirstRunConfirm" PasswordChar="●" Watermark="Confirm master password..."
                                     Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="44" FontSize="14"/>
                            <Button Grid.Column="1" Name="BtnToggleFirstRunConfirm" Content="👁" Background="#1C1C21" Foreground="#8A8A93"
                                    BorderBrush="#2E2E35" Height="44" Width="44" Margin="4,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hardware Security Card -->
                <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="BIOMETRICS &amp; SECURITY" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                        <CheckBox Name="ChkFirstRunBiometrics" Content="Enable Fingerprint / Face Unlock" IsChecked="True" Foreground="#EDEDED"/>
                        <TextBlock Text="Protects master key in your phone's hardware security chip. Allows instant unlock with fingerprint or face."
                                   FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Name="TxtFirstRunError" Foreground="#E83030" FontSize="13" HorizontalAlignment="Center"
                           IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>

                <Button Name="BtnFirstRunCreate" Content="Create Encrypted Vault" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#005FB8" Foreground="White" Height="48" CornerRadius="6" FontSize="15" FontWeight="SemiBold"/>

                <Button Name="BtnFirstRunImportExisting" Content="📂 Open / Import Existing Vault File" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" BorderThickness="1" Height="44" CornerRadius="6" FontSize="14"/>

                <StackPanel Name="PnlFirstRunProgress" Spacing="6" Margin="0,4,0,0" IsVisible="False">
                    <ProgressBar IsIndeterminate="True" Height="4" Foreground="#005FB8" Background="#1C1C21"/>
                    <TextBlock Text="Creating and securing your vault..." FontSize="12" Foreground="#8A8A93" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 2. RECOVERY CODE DISPLAY PANEL ==================== -->
        <ScrollViewer Name="PanelRecoveryDisplay" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,54,24,32" Spacing="16">
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="0,8,0,12">
                    <TextBlock Text="🔑" FontSize="32" HorizontalAlignment="Center"/>
                    <TextBlock Text="EMERGENCY RECOVERY CODE (52 CHARACTERS)" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" LetterSpacing="1" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Save this 52-character emergency code in a secure location. If you ever forget your master password, this code is the ONLY way to recover your vault."
                               FontSize="13" Foreground="#8A8A93" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Background="#2A1F0A" BorderBrush="#5A431A" BorderThickness="1" CornerRadius="8" Padding="14">
                    <TextBlock Text="WARNING: Keep this code private and safe. Anyone with this code can unlock your vault."
                               Foreground="#E8A030" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>

                <!-- Code Display Box (Full 52 Crockford-32 Characters) -->
                <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                    <SelectableTextBlock Name="TxtRecoveryDisplayCode" Text="---- ---- ---- ---- ---- ---- ---- ---- ---- ---- ---- ---- ----"
                                         FontFamily="Consolas, Courier New, monospace" FontSize="15" FontWeight="Bold"
                                         Foreground="#26A0DA" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>

                <Button Name="BtnCopyRecoveryCode" Content="📋 Copy Code to Clipboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#2E2E35" Foreground="#EDEDED" Height="44" CornerRadius="6" FontSize="14"/>

                <TextBlock Name="TxtCopyNotice" Text="✓ Copied to clipboard! (Clears automatically in 60s)" Foreground="#2FBF71" FontSize="13" HorizontalAlignment="Center" IsVisible="False"/>

                <CheckBox Name="ChkConfirmRecoverySaved" Content="I have safely recorded this recovery code" Foreground="#EDEDED" Margin="0,8,0,0"/>

                <Button Name="BtnFinishSetupAndEnter" Content="Enter Vault" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#005FB8" Foreground="White" Height="48" CornerRadius="6" FontSize="15" FontWeight="SemiBold" IsEnabled="False"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 3. LOCKED PANEL (VAULT EXISTS) ==================== -->
        <ScrollViewer Name="PanelLocked" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,56,24,28" Spacing="16">
                <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,16,0,16">
                    <TextBlock Text="RDP VAULT" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" LetterSpacing="2"/>
                    <TextBlock Text="Hardware-Encrypted Mobile Remote Desktop" FontSize="13" Foreground="#8A8A93" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Hardware Biometric Card (Only visible when enrolled) -->
                <Border Name="PnlBiometricCard" Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16" IsVisible="False">
                    <StackPanel Spacing="10">
                        <TextBlock Text="DEVICE BIOMETRICS" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                        <Button Name="BtnBiometricUnlock" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#005FB8" Foreground="White" Height="48" CornerRadius="6" FontSize="15" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🔒" VerticalAlignment="Center"/>
                                <TextBlock Text="Unlock with Fingerprint / Face" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Master Password Unlock Card -->
                <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="MASTER PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="TxtPassword" PasswordChar="●" Watermark="Enter master password..."
                                     Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="44" FontSize="15"/>
                            <Button Grid.Column="1" Name="BtnToggleUnlockPass" Content="👁" Background="#1C1C21" Foreground="#8A8A93"
                                    BorderBrush="#2E2E35" Height="44" Width="44" Margin="4,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </Grid>
                        <Button Name="BtnUnlock" Content="Unlock Vault" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#005FB8" Foreground="White" Height="44" CornerRadius="6" FontSize="15" FontWeight="SemiBold"/>

                        <TextBlock Name="TxtLockNotice" Foreground="#2FBF71" FontSize="13" HorizontalAlignment="Center"
                                   IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>

                        <TextBlock Name="TxtLockError" Foreground="#E83030" FontSize="13" HorizontalAlignment="Center"
                                   IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>

                        <StackPanel Name="PnlUnlockProgress" Spacing="6" Margin="0,4,0,0" IsVisible="False">
                            <ProgressBar IsIndeterminate="True" Height="4" Foreground="#005FB8" Background="#1C1C21"/>
                            <TextBlock Name="TxtUnlockStatus" Text="Verifying password and unlocking..." FontSize="12" Foreground="#8A8A93" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recovery Code link -->
                <Button Name="BtnShowRecovery" Content="Forgot Master Password? Use Recovery Code"
                        Background="Transparent" Foreground="#8A8A93" FontSize="13" HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 4. RECOVERY UNLOCK PANEL ==================== -->
        <ScrollViewer Name="PanelRecoveryUnlock" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,54,24,32" Spacing="16">
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="0,8,0,12">
                    <TextBlock Text="VAULT RECOVERY (52 CHARACTERS)" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" LetterSpacing="1" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Enter your 52-character recovery code to reset your master password."
                               FontSize="13" Foreground="#8A8A93" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="RECOVERY CODE" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="TxtRecoveryInput" Watermark="XXXX-XXXX-XXXX-... (52 characters)"
                                     Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="44" FontSize="13"
                                     FontFamily="Consolas, Courier New, monospace"/>
                            <Button Grid.Column="1" Name="BtnPasteRecoveryCode" Content="📋 Paste" Background="#1C1C21" Foreground="#EDEDED"
                                    BorderBrush="#2E2E35" BorderThickness="1" Height="44" Padding="12,0" Margin="4,0,0,0"
                                    VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Name="TxtRecoveryCharCount" Text="0 / 52 characters" FontSize="11" Foreground="#8A8A93" Margin="2,-4,0,0"/>

                        <TextBlock Text="NEW MASTER PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="TxtRecoveryNewPass" PasswordChar="●" Watermark="New master password (min 8 chars)..."
                                     Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="44" FontSize="14"/>
                            <Button Grid.Column="1" Name="BtnToggleRecoveryNewPass" Content="👁" Background="#1C1C21" Foreground="#8A8A93"
                                    BorderBrush="#2E2E35" Height="44" Width="44" Margin="4,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="TxtRecoveryConfirmPass" PasswordChar="●" Watermark="Confirm new master password..."
                                     Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="44" FontSize="14"/>
                            <Button Grid.Column="1" Name="BtnToggleRecoveryConfirmPass" Content="👁" Background="#1C1C21" Foreground="#8A8A93"
                                    BorderBrush="#2E2E35" Height="44" Width="44" Margin="4,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </Grid>

                        <TextBlock Name="TxtRecoveryUnlockError" Foreground="#E83030" FontSize="13" HorizontalAlignment="Center"
                                   IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>

                        <Button Name="BtnSubmitRecoveryUnlock" Content="Recover &amp; Reset Password" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="#005FB8" Foreground="White" Height="44" CornerRadius="6" FontSize="15" FontWeight="SemiBold"/>

                        <Button Name="BtnCancelRecoveryUnlock" Content="Back to Lock Screen" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="Transparent" Foreground="#8A8A93" Height="40" FontSize="13"/>

                        <StackPanel Name="PnlRecoveryUnlockProgress" Spacing="6" Margin="0,4,0,0" IsVisible="False">
                            <ProgressBar IsIndeterminate="True" Height="4" Foreground="#005FB8" Background="#1C1C21"/>
                            <TextBlock Text="Verifying emergency recovery code..." FontSize="12" Foreground="#8A8A93" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 5. UNLOCKED PANEL ==================== -->
        <Grid Name="PanelUnlocked" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16,52,16,16" IsVisible="False">
            <!-- Header Bar with safe margin below status bar and separate subtitle row -->
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="RDP VAULT" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Name="BtnAddProfile" Content="+ Add" Background="#005FB8" Foreground="White"
                            Margin="0,0,6,0" CornerRadius="4" Height="38" Padding="14,0"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="2" Name="BtnSettings" Content="⚙" Background="#1C1C21" Foreground="#EDEDED"
                            Margin="0,0,6,0" CornerRadius="4" Height="38" Width="38"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <Button Grid.Column="3" Name="BtnLock" Content="Lock" Background="#2E2E35" Foreground="#EDEDED"
                            CornerRadius="4" Height="38" Padding="14,0"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </Grid>
                <TextBlock Grid.Row="1" Name="TxtUnlockedStatus" Text="Vault Unlocked"
                           FontSize="11" Foreground="#2FBF71" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!-- Active Remote Session Status & Fast Return Banner -->
            <Border Grid.Row="1" Name="BannerActiveSession" Background="#162719" BorderBrush="#2FBF71" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" IsVisible="False">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="●" FontSize="11" Foreground="#2FBF71" VerticalAlignment="Center"/>
                            <TextBlock Text="ACTIVE REMOTE SESSION (EXTERNAL)" FontSize="11" FontWeight="Bold" Foreground="#2FBF71" LetterSpacing="1"/>
                        </StackPanel>
                        <Button Grid.Column="1" Name="BtnDismissActiveBanner" Content="✕ Dismiss" Background="Transparent" Foreground="#8A8A93" Height="26" Padding="6,0" FontSize="11"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    </Grid>
                    <TextBlock Name="TxtActiveSessionDetails" Text="Connected to Remote PC" FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Grid.Column="0" Name="BtnReturnToRdp" Content="Resume RDP" Background="#005FB8" Foreground="White" Height="36" CornerRadius="4"
                                HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Name="BtnEndActiveSession" Content="End Session" Background="#B80000" Foreground="White" Height="36" CornerRadius="4"
                                HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Search / Filter Bar -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBox Grid.Column="0" Name="TxtSearch" Watermark="Search connections (name, host, user, notes)..."
                         Background="#141417" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="42" FontSize="14"/>
                <Button Grid.Column="1" Name="BtnClearSearch" Content="✕" Background="#141417" Foreground="#8A8A93"
                        BorderBrush="#2E2E35" Height="42" Width="42" Margin="4,0,0,0"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            </Grid>

            <!-- Profiles List -->
            <ScrollViewer Grid.Row="3">
                <StackPanel Spacing="10">
                    <TextBlock Name="TxtEmptyProfiles" Text="No connections yet. Tap '+ Add' above to configure your first computer."
                               Foreground="#8A8A93" FontSize="13" HorizontalAlignment="Center" Margin="0,32,0,0" IsVisible="False" TextWrapping="Wrap" TextAlignment="Center"/>
                    <StackPanel Name="PnlProfilesList" Spacing="10"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 6. PROFILE EDITOR OVERLAY ==================== -->
        <Grid Name="PanelProfileEditor" RowDefinitions="Auto,*" Margin="16,52,16,16" IsVisible="False">
            <!-- Sticky Header Bar: Cancel / Title / Save -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                <Button Grid.Column="0" Name="BtnTopCancelProfile" Content="Cancel" Background="#2E2E35" Foreground="#EDEDED"
                        Height="38" Padding="14,0" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <TextBlock Grid.Column="1" Name="TxtEditorTitle" Text="New Connection" FontSize="18" FontWeight="Bold"
                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Name="BtnTopSaveProfile" Content="Save" Background="#005FB8" Foreground="White"
                        Height="38" Padding="18,0" CornerRadius="4" FontWeight="SemiBold"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            </Grid>

            <!-- Scrollable Form with 400px bottom padding so keyboard NEVER occludes fields -->
            <ScrollViewer Grid.Row="1" Name="ScrollProfileEditor" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,400" Spacing="14">
                    <!-- General Details -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="CONNECTION NAME" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBox Name="TxtProfileName" Watermark="e.g. Office Desktop" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>

                            <TextBlock Text="HOST / IP ADDRESS" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBox Name="TxtProfileHost" Watermark="e.g. 192.168.1.100 or mypc.ddns.net" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>

                            <TextBlock Text="PORT (DEFAULT 3389)" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBox Name="TxtProfilePort" Text="3389" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>

                            <TextBlock Text="USERNAME" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBox Name="TxtProfileUser" Watermark="e.g. Administrator or DOMAIN\User" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>

                            <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBox Name="TxtProfilePass" PasswordChar="●" Watermark="Remote desktop password" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>

                            <TextBlock Text="RD GATEWAY SERVER (OPTIONAL)" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBox Name="TxtProfileGateway" Watermark="e.g. gateway.company.com (RD Gateway)" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>
                        </StackPanel>
                    </Border>

                    <!-- Remote Display Resolution & Multi-Monitor Safety Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="REMOTE DISPLAY &amp; MONITOR PROTECTION" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBlock Text="Display Resolution Preset" FontSize="12" Foreground="#8A8A93"/>
                            <ComboBox Name="CmbProfileResolution" HorizontalAlignment="Stretch" Background="#1C1C21" BorderBrush="#2E2E35" Foreground="#EDEDED">
                                <ComboBoxItem Content="Default (Follow Global Vault Setting: 1920x1080)"/>
                                <ComboBoxItem Content="1920 x 1080 (1080p Full HD - Safe for Desktop Monitors)"/>
                                <ComboBoxItem Content="1280 x 720 (720p HD - Bandwidth Saver)"/>
                                <ComboBoxItem Content="1600 x 900 (900p HD+)"/>
                                <ComboBoxItem Content="1366 x 768 (Standard Laptop)"/>
                                <ComboBoxItem Content="2560 x 1440 (1440p 2K QHD)"/>
                                <ComboBoxItem Content="3840 x 2160 (4K Ultra HD)"/>
                                <ComboBoxItem Content="Match Mobile Device Screen"/>
                                <ComboBoxItem Content="Custom Resolution..."/>
                            </ComboBox>

                            <!-- Custom Resolution Fields -->
                            <Grid Name="PnlProfileCustomRes" ColumnDefinitions="*,10,*" IsVisible="False">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Width (pixels)" FontSize="11" Foreground="#8A8A93"/>
                                    <TextBox Name="TxtProfileCustomWidth" Text="1920" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Height (pixels)" FontSize="11" Foreground="#8A8A93"/>
                                    <TextBox Name="TxtProfileCustomHeight" Text="1080" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Remote Multi-Monitor Mode" FontSize="12" Foreground="#8A8A93" Margin="0,4,0,0"/>
                            <ComboBox Name="CmbProfileMultiMon" HorizontalAlignment="Stretch" Background="#1C1C21" BorderBrush="#2E2E35" Foreground="#EDEDED">
                                <ComboBoxItem Content="Default (Follow Global Vault Setting)"/>
                                <ComboBoxItem Content="Single Monitor Only (Locks to primary display to protect multi-monitors)"/>
                                <ComboBoxItem Content="Span All Remote Monitors (Multi-monitor)"/>
                            </ComboBox>

                            <CheckBox Name="ChkProfilePreserveNative" Content="Keep Native 1920x1080 (Never squash or distort — scroll to view)" Foreground="#EDEDED" IsChecked="True" FontSize="13"/>
                            <TextBlock Name="TxtProfilePreserveNativeHint" Text="💡 Recommended: Windows resolution stays strictly at full 1920x1080 in both portrait and landscape. Nothing is squashed or distorted. You scroll side-to-side and up/down to reach all points of the screen."
                                       FontSize="11" Foreground="#2FBF71" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Wake-on-LAN Settings Card -->
                    <Border Name="CardWol" Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="WAKE-ON-LAN (REMOTE POWER ON)" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <CheckBox Name="ChkProfileEnableWol" Content="Send wake-up signal before connecting (WOL)" Foreground="#EDEDED"/>
                            <StackPanel Name="PnlWolDetails" Spacing="10" IsVisible="False">
                                <TextBlock Text="MAC ADDRESS" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                                <TextBox Name="TxtProfileWolMac" Watermark="MAC Address (e.g. AA:BB:CC:DD:EE:FF)" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>
                                <Grid ColumnDefinitions="*,10,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="WOL Port" FontSize="11" Foreground="#8A8A93"/>
                                        <TextBox Name="TxtProfileWolPort" Text="9" Watermark="9" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="Wait seconds" FontSize="11" Foreground="#8A8A93"/>
                                        <TextBox Name="TxtProfileWolWait" Text="25" Watermark="25" Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Security & Certificates Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="SECURITY &amp; CERTIFICATES" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <CheckBox Name="ChkProfileSuppressCert" Content="Ignore certificate warnings (Recommended for home/work networks)" Foreground="#EDEDED" IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <!-- Notes Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="NOTES" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBox Name="TxtProfileNotes" Watermark="Optional connection notes..." AcceptsReturn="True" Height="60"
                                     Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Name="TxtProfileError" Foreground="#E83030" FontSize="13" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap"/>

                    <!-- Bottom Action Buttons -->
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,10,*">
                            <Button Grid.Column="0" Name="BtnBottomCancelProfile" Content="Cancel" Background="#2E2E35" Foreground="#EDEDED"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Height="46" CornerRadius="6" FontSize="14"/>
                            <Button Grid.Column="2" Name="BtnSaveProfile" Content="Save Connection" Background="#005FB8" Foreground="White"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Height="46" CornerRadius="6" FontWeight="SemiBold" FontSize="15"/>
                        </Grid>
                        <Button Name="BtnDeleteProfile" Content="Delete Connection" Background="#B80000" Foreground="White"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Height="44" CornerRadius="6" IsVisible="False"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 7. SETTINGS PANEL ==================== -->
        <Grid Name="PanelSettings" RowDefinitions="Auto,*" Margin="16,52,16,16" IsVisible="False">
            <!-- Sticky Top Header Bar: Back / Title -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                <Button Grid.Column="0" Name="BtnTopCloseSettings" Content="← Back" Background="#2E2E35" Foreground="#EDEDED"
                        Height="38" Padding="14,0" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Vault Settings" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,180" Spacing="16">
                    <!-- Biometric Hardware Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="DEVICE BIOMETRICS (FINGERPRINT / FACE UNLOCK)" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBlock Name="TxtBiometricStatus" Text="Biometrics: Not enrolled" FontSize="13" Foreground="#EDEDED"/>
                            <Button Name="BtnToggleBiometrics" Content="Enroll Biometrics" Background="#005FB8" Foreground="White"
                                    Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Auto-Lock Inactivity Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="AUTO-LOCK TIMEOUT" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBlock Text="Automatically lock the vault when the app is backgrounded or left idle." FontSize="12" Foreground="#8A8A93"/>
                            <ComboBox Name="CmbSettingsAutoLock" HorizontalAlignment="Stretch" Background="#1C1C21" BorderBrush="#2E2E35" Foreground="#EDEDED">
                                <ComboBoxItem Content="1 minute"/>
                                <ComboBoxItem Content="5 minutes"/>
                                <ComboBoxItem Content="15 minutes"/>
                                <ComboBoxItem Content="30 minutes"/>
                                <ComboBoxItem Content="60 minutes (Default)"/>
                                <ComboBoxItem Content="Never (Keep unlocked while in memory)"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Remote Display & Resolution Defaults (Monitor Protection) -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="REMOTE DISPLAY &amp; RESOLUTION DEFAULTS" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBlock Text="Default Display Resolution" FontSize="12" Foreground="#8A8A93"/>
                            <ComboBox Name="CmbSettingsResolution" HorizontalAlignment="Stretch" Background="#1C1C21" BorderBrush="#2E2E35" Foreground="#EDEDED">
                                <ComboBoxItem Content="1920 x 1080 (1080p Full HD - Safe for Desktop Monitors)"/>
                                <ComboBoxItem Content="1280 x 720 (720p HD - Bandwidth Saver)"/>
                                <ComboBoxItem Content="1600 x 900 (900p HD+)"/>
                                <ComboBoxItem Content="1366 x 768 (Standard Laptop)"/>
                                <ComboBoxItem Content="2560 x 1440 (1440p 2K QHD)"/>
                                <ComboBoxItem Content="3840 x 2160 (4K Ultra HD)"/>
                                <ComboBoxItem Content="Match Mobile Device Screen"/>
                            </ComboBox>

                            <TextBlock Text="Remote Multi-Monitor Safety Mode" FontSize="12" Foreground="#8A8A93" Margin="0,4,0,0"/>
                            <ComboBox Name="CmbSettingsMultiMon" HorizontalAlignment="Stretch" Background="#1C1C21" BorderBrush="#2E2E35" Foreground="#EDEDED">
                                <ComboBoxItem Content="Single Monitor Only (Recommended: prevents scrambling remote dual/multi-monitors)"/>
                                <ComboBoxItem Content="Use All Remote Displays (Span all monitors)"/>
                            </ComboBox>

                            <CheckBox Name="ChkSettingsPreserveNative" Content="Keep Native 1920x1080 by default (Never squash or distort — scroll to view)" Foreground="#EDEDED" IsChecked="True" FontSize="13"/>
                            <TextBlock Name="TxtSettingsPreserveNativeHint" Text="💡 Recommended: Keeps remote Windows sessions at full 1920x1080 in both portrait and landscape. Prevents remote apps and desktop icons from being squashed."
                                       FontSize="11" Foreground="#2FBF71" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Auto-Type Password Injector Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="AUTO-TYPE PASSWORD INJECTION" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBlock Text="Directly injects remote desktop passwords into Microsoft Remote Desktop with zero clipboard usage and zero credential storage in external apps."
                                       FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                            <TextBlock Name="TxtAccessibilityStatus" Text="Checking accessibility status..." FontSize="12" Foreground="#2FBF71" TextWrapping="Wrap"/>
                            <Button Name="BtnSettingsAccessibility" Content="⚙ Configure Accessibility Auto-Type" Background="#2E2E35" Foreground="#EDEDED"
                                    Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Vault Backup & File Transfer Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="VAULT BACKUP &amp; FILE TRANSFER" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBlock Text="Export your encrypted vault file (vault.rdpv) to transfer to your PC or another phone, or restore from a backup."
                                       FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,10,*">
                                <Button Grid.Column="0" Name="BtnExportVault" Content="📤 Export Vault (.rdpv)" Background="#2E2E35" Foreground="#EDEDED"
                                        Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                <Button Grid.Column="2" Name="BtnImportVault" Content="📥 Import Vault (.rdpv)" Background="#2E2E35" Foreground="#EDEDED"
                                        Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <TextBlock Name="TxtVaultBackupStatus" Text="" FontSize="12" Foreground="#2FBF71" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Recovery Code Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="EMERGENCY RECOVERY CODE" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <TextBlock Text="Your emergency recovery code is sealed inside your vault. For security, it cannot be read in plain text. You can generate a fresh recovery code anytime."
                                       FontSize="12" Foreground="#8A8A93" TextWrapping="Wrap"/>
                            <Button Name="BtnRegenerateRecoveryCode" Content="Generate Fresh Recovery Code" Background="#2E2E35" Foreground="#EDEDED"
                                    Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Change Master Password Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="CHANGE MASTER PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Name="TxtSettingsCurrentPass" PasswordChar="●" Watermark="Current master password..."
                                         Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>
                                <Button Grid.Column="1" Name="BtnToggleSettingsCurrentPass" Content="👁" Background="#1C1C21" Foreground="#8A8A93"
                                         BorderBrush="#2E2E35" Height="40" Width="40" Margin="4,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Name="TxtSettingsNewPass" PasswordChar="●" Watermark="New master password (min 8 chars)..."
                                         Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>
                                <Button Grid.Column="1" Name="BtnToggleSettingsNewPass" Content="👁" Background="#1C1C21" Foreground="#8A8A93"
                                         BorderBrush="#2E2E35" Height="40" Width="40" Margin="4,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Name="TxtSettingsConfirmPass" PasswordChar="●" Watermark="Confirm new master password..."
                                         Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="40"/>
                                <Button Grid.Column="1" Name="BtnToggleSettingsConfirmPass" Content="👁" Background="#1C1C21" Foreground="#8A8A93"
                                         BorderBrush="#2E2E35" Height="40" Width="40" Margin="4,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </Grid>

                            <TextBlock Name="TxtChangePasswordError" Foreground="#E83030" FontSize="13" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap"/>

                            <Button Name="BtnChangeMasterPassword" Content="Update Master Password" Background="#2E2E35" Foreground="#EDEDED"
                                    Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                            <StackPanel Name="PnlChangePassProgress" Spacing="6" Margin="0,4,0,0" IsVisible="False">
                                <ProgressBar IsIndeterminate="True" Height="4" Foreground="#005FB8" Background="#1C1C21"/>
                                <TextBlock Text="Updating master password..." FontSize="12" Foreground="#8A8A93" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- General Connection & Security Defaults Card -->
                    <Border Background="#141417" CornerRadius="8" BorderBrush="#2E2E35" BorderThickness="1" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="CONNECTION &amp; SECURITY DEFAULTS" FontSize="11" FontWeight="Bold" Foreground="#8A8A93" LetterSpacing="1"/>
                            <CheckBox Name="ChkSettingsSuppressCert" Content="Ignore certificate warnings by default (Recommended for private/home networks)" Foreground="#EDEDED" IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <Button Name="BtnCloseSettings" Content="Back to Connections" Background="#2E2E35" Foreground="#EDEDED"
                            Height="44" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 8. MODALS & OVERLAYS ==================== -->

        <!-- Tactical Launch & WOL Progress Overlay -->
        <Border Name="OverlayLaunch" Background="#E00A0A0C" IsVisible="False" ZIndex="200">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Name="TxtLaunchTitle" Text="CONNECTING TO REMOTE COMPUTER" FontSize="15" FontWeight="Bold"
                                   Foreground="#EDEDED" LetterSpacing="1"/>
                        <TextBlock Name="TxtLaunchTarget" Text="Target Host" FontSize="12" Foreground="#8A8A93"/>
                    </StackPanel>

                    <!-- Progress Bar -->
                    <StackPanel Spacing="6">
                        <ProgressBar Name="ProgLaunch" Height="6" CornerRadius="3" Foreground="#005FB8" Background="#24242A"
                                     IsIndeterminate="True" Minimum="0" Maximum="100"/>
                        <TextBlock Name="TxtLaunchCountdown" Text="" FontSize="11" Foreground="#8AB4F8"
                                   HorizontalAlignment="Right" IsVisible="False"/>
                    </StackPanel>

                    <!-- Step details -->
                    <Border Background="#0E0E10" BorderBrush="#24242A" BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="▶ " FontSize="12" Foreground="#007AE8" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Name="TxtLaunchStep" Text="Connecting..."
                                       FontSize="12" Foreground="#EDEDED" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Auto-Type / Credential notice -->
                    <Border Name="CardLaunchPasswordTip" Background="#18181D" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="4" Padding="10,8" IsVisible="False">
                        <StackPanel Spacing="2">
                            <TextBlock Name="TxtLaunchPasswordTipTitle" Text="ZERO-CLIPBOARD AUTO-TYPE" FontSize="10" FontWeight="Bold" Foreground="#8AB4F8"/>
                            <TextBlock Name="TxtLaunchPasswordTipBody" Text="🔒 Auto-Type Active: Password will be injected directly into Microsoft Remote Desktop with zero clipboard exposure." FontSize="10" Foreground="#2FBF71" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Screen Scroll & Pan Guidance -->
                    <Border Background="#141417" BorderBrush="#24242A" BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="💡 " FontSize="12" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="To scroll side-to-side and up/down without squashing: In Remote Desktop, tap the top bar and tap the 🔍 (Pan/Zoom) icon. Your 1920x1080 desktop stays full size!"
                                       FontSize="11" Foreground="#8AB4F8" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Action buttons -->
                    <Grid ColumnDefinitions="*,Auto,8,Auto">
                        <TextBlock Name="TxtLaunchSubStatus" Grid.Column="0" Text="" FontSize="11" Foreground="#2FBF71"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Name="BtnSkipWolWait" Content="Connect Now" Background="#005FB8" Foreground="White"
                                Height="36" Padding="12,0" CornerRadius="4" IsVisible="False"/>
                        <Button Grid.Column="3" Name="BtnCancelLaunch" Content="Cancel" Height="36" Padding="14,0" CornerRadius="4" Click="BtnCancelLaunch_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Delete Confirmation Modal Overlay -->
        <Border Name="OverlayConfirmDelete" Background="#E00A0A0C" IsVisible="False" ZIndex="250">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Delete Connection?" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Name="TxtConfirmDeleteMessage" Text="Are you sure you want to delete this connection? This cannot be undone."
                               FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,10,*">
                        <Button Grid.Column="0" Name="BtnCancelDelete" Content="Cancel" Background="#2E2E35" Foreground="#EDEDED"
                                Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Name="BtnConfirmDelete" Content="Delete" Background="#B80000" Foreground="White"
                                Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Discard Changes Confirmation Modal Overlay -->
        <Border Name="OverlayConfirmDiscardProfile" Background="#E00A0A0C" IsVisible="False" ZIndex="250">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Discard Unsaved Changes?" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="You have unsaved changes to this connection. If you leave now, all your edits will be discarded."
                               FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,10,*">
                        <Button Grid.Column="0" Name="BtnKeepEditingProfile" Content="Keep Editing" Background="#005FB8" Foreground="White"
                                Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
                        <Button Grid.Column="2" Name="BtnConfirmDiscardProfile" Content="Discard" Background="#B80000" Foreground="White"
                                Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Restore Vault Backup Confirmation Modal Overlay -->
        <Border Name="OverlayConfirmRestoreVault" Background="#E00A0A0C" IsVisible="False" ZIndex="250">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Restore Vault Backup?" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Restoring from a backup file will replace all current connections and settings on this device. A backup (.bak) of your current vault will be saved. Continue?"
                               FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,10,*">
                        <Button Grid.Column="0" Name="BtnCancelRestoreVault" Content="Cancel" Background="#2E2E35" Foreground="#EDEDED"
                                Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Name="BtnConfirmRestoreVault" Content="Restore &amp; Replace" Background="#005FB8" Foreground="White"
                                Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Password Verification Modal for Generating Fresh Recovery Code -->
        <Border Name="OverlayPromptPasswordForRecovery" Background="#E00A0A0C" IsVisible="False" ZIndex="250">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Verify Master Password" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Enter your master password to generate a fresh 52-character Emergency Recovery Code:"
                               FontSize="13" Foreground="#8A8A93" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Name="TxtVerifyPassForRecovery" PasswordChar="●" Watermark="Master password..."
                                 Background="#1C1C21" Foreground="#EDEDED" BorderBrush="#2E2E35" Height="42" FontSize="14"/>
                        <Button Grid.Column="1" Name="BtnToggleVerifyRecoveryPass" Content="👁" Background="#1C1C21" Foreground="#8A8A93"
                                BorderBrush="#2E2E35" Height="42" Width="42" Margin="4,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    </Grid>
                    <TextBlock Name="TxtVerifyPassForRecoveryError" Foreground="#E83030" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,10,*">
                        <Button Grid.Column="0" Name="BtnCancelVerifyPassForRecovery" Content="Cancel" Background="#2E2E35" Foreground="#EDEDED"
                                Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Name="BtnSubmitVerifyPassForRecovery" Content="Generate Code" Background="#005FB8" Foreground="White"
                                Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Enable Accessibility Auto-Type Modal Overlay -->
        <Border Name="OverlayEnableAccessibility" Background="#E00A0A0C" IsVisible="False" ZIndex="260">
            <Border Background="#141417" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="8"
                    Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="🔒 ZERO-CLIPBOARD AUTO-TYPE" FontSize="11" FontWeight="Bold" Foreground="#8AB4F8" LetterSpacing="1"/>
                        <TextBlock Text="Enable Auto-Type in Accessibility" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </StackPanel>

                    <TextBlock Text="To inject your password directly into Microsoft Remote Desktop with zero clipboard usage and zero credential storage in external apps, turn ON RDP Vault in Android Accessibility settings."
                               FontSize="13" Foreground="#EDEDED" TextWrapping="Wrap"/>

                    <Border Background="#1A1813" BorderBrush="#664D03" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="💡 HOW TO ACTIVATE (ONE-TIME STEP):" FontSize="11" FontWeight="Bold" Foreground="#FFC107"/>
                            <TextBlock Text="1. Tap 'Open Accessibility Settings' below.&#x0a;2. Find 'RDP Vault Auto-Type' in the list.&#x0a;3. Turn it ON and confirm."
                                       FontSize="12" Foreground="#EDEDED" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid RowDefinitions="Auto,8,Auto,8,Auto">
                        <Button Grid.Row="0" Name="BtnOpenAccessibilitySettings" Content="⚙ Open Accessibility Settings" Background="#005FB8" Foreground="White"
                                Height="42" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
                        <Button Grid.Row="2" Name="BtnContinueWithoutAccessibility" Content="Connect Anyway (Manual Entry)" Background="#2E2E35" Foreground="#EDEDED"
                                Height="38" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Row="4" Name="BtnCancelAccessibilityPrompt" Content="Cancel" Background="#1C1C21" Foreground="#8A8A93"
                                Height="36" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
