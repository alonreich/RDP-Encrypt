<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RDPVault.ProfileEditorWindow"
        Title="Edit Profile" Width="500" Height="780"
        Icon="avares://RDPVault/Assets/icon.ico"
        WindowStartupLocation="CenterOwner" CanResize="True"
        Background="#0E0E10" Foreground="#EDEDED" FontFamily="Inter, Arial">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#141417"/>
            <Setter Property="BorderBrush" Value="#2E2E35"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="#005FB8"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#2E2E35"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A30"/>
        </Style>
        <Style Selector="Button.Accent">
            <Setter Property="Background" Value="#005FB8"/>
            <Setter Property="BorderBrush" Value="#006CD0"/>
        </Style>
        <Style Selector="Button.Accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#006CD0"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#EDEDED"/>
        </Style>
    </Window.Styles>

    <ScrollViewer>
    <StackPanel Margin="24" Spacing="10">
        <TextBlock Text="PROFILE SETTINGS" FontSize="18" FontWeight="Bold" LetterSpacing="1" Margin="0,0,0,6"/>

        <TextBlock Text="Display name" FontSize="13" Foreground="#8A8A93"/>
        <TextBox Name="TxtName" Watermark="e.g. Production Server"/>

        <Grid ColumnDefinitions="*,10,110">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Host / IP address" FontSize="13" Foreground="#8A8A93"/>
                <TextBox Name="TxtHost" Watermark="e.g. 192.168.1.100"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Port" FontSize="13" Foreground="#8A8A93"/>
                <TextBox Name="TxtPort" Watermark="3389"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Username" FontSize="13" Foreground="#8A8A93"/>
        <TextBox Name="TxtUsername" Watermark="Administrator"/>

        <TextBlock Text="Password (leave empty to be asked at connect time)" FontSize="13" Foreground="#8A8A93"/>
        <TextBox Name="TxtPassword" PasswordChar="•" Watermark="Password"/>
        <CheckBox Name="ChkShowPassword" Content="Show password" FontSize="12" Click="ChkShowPassword_Click"/>

        <TextBlock Text="RD Gateway host (optional)" FontSize="13" Foreground="#8A8A93" Margin="0,6,0,0"/>
        <TextBox Name="TxtGateway" Watermark="gateway.example.com"/>

        <!-- Display settings -->
        <TextBlock Text="Display resolution preset" FontSize="13" Foreground="#8A8A93" Margin="0,6,0,0"/>
        <ComboBox Name="CmbResolution" HorizontalAlignment="Stretch" Background="#141417"
                  BorderBrush="#2E2E35" Foreground="#EDEDED">
            <ComboBoxItem Content="Full screen"/>
            <ComboBoxItem Content="Use all monitors (multi-monitor)"/>
            <ComboBoxItem Content="1920 x 1080"/>
            <ComboBoxItem Content="1600 x 900"/>
            <ComboBoxItem Content="1366 x 768"/>
            <ComboBoxItem Content="1280 x 1024"/>
            <ComboBoxItem Content="1280 x 800"/>
            <ComboBoxItem Content="1024 x 768"/>
            <ComboBoxItem Content="800 x 600"/>
        </ComboBox>

        <!-- Overrides -->
        <TextBlock Text="Full screen override" FontSize="13" Foreground="#8A8A93" Margin="0,6,0,0"/>
        <ComboBox Name="CmbFullScreen" HorizontalAlignment="Stretch" Background="#141417"
                  BorderBrush="#2E2E35" Foreground="#EDEDED">
            <ComboBoxItem Content="Default (Follow Global Vault Settings)"/>
            <ComboBoxItem Content="Always Full Screen"/>
            <ComboBoxItem Content="Always Windowed Mode"/>
        </ComboBox>

        <TextBlock Text="Multi-monitor override" FontSize="13" Foreground="#8A8A93" Margin="0,6,0,0"/>
        <ComboBox Name="CmbMultiMon" HorizontalAlignment="Stretch" Background="#141417"
                  BorderBrush="#2E2E35" Foreground="#EDEDED">
            <ComboBoxItem Content="Default (Follow Global Vault Settings)"/>
            <ComboBoxItem Content="Always Use All Monitors (Multi-monitor)"/>
            <ComboBoxItem Content="Single Monitor Only"/>
        </ComboBox>

        <TextBlock Text="Certificate &amp; identity warnings override" FontSize="13" Foreground="#8A8A93" Margin="0,6,0,0"/>
        <ComboBox Name="CmbCertWarnings" HorizontalAlignment="Stretch" Background="#141417"
                  BorderBrush="#2E2E35" Foreground="#EDEDED">
            <ComboBoxItem Content="Default (Follow Global Vault Settings)"/>
            <ComboBoxItem Content="Always Suppress Warnings (Ignore untrusted certs)"/>
            <ComboBoxItem Content="Always Show Warnings (Ask before connecting)"/>
        </ComboBox>

        <!-- Wake-on-LAN (WOL) -->
        <Border Background="#121215" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="4"
                Padding="12" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="WAKE-ON-LAN (WOL)" FontSize="13" FontWeight="Bold" Foreground="#EDEDED"/>
                <CheckBox Name="ChkEnableWol">
                    <TextBlock Text="Send Wake-on-LAN magic packet before connecting" Foreground="#EDEDED"/>
                </CheckBox>
                <StackPanel Name="PnlWolDetails" Spacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Target MAC address (e.g. 00:11:22:33:44:55)" FontSize="12" Foreground="#8A8A93"/>
                        <TextBox Name="TxtWolMac" Watermark="00:11:22:33:44:55"
                                 ToolTip.Tip="Accepts any MAC format (e.g. 00:11:22:33:44:55, 00-11-22-33-44-55, 001122334455). Automatically formatted on exit."/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,80,10,100">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Broadcast IP" FontSize="12" Foreground="#8A8A93"/>
                            <TextBox Name="TxtWolBroadcast" Watermark="Auto (Host &amp; all subnets)"
                                     ToolTip.Tip="Target IP or broadcast. Default sends to remote Host IP/hostname, all local network adapters, and 255.255.255.255."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Port" FontSize="12" Foreground="#8A8A93"/>
                            <TextBox Name="TxtWolPort" Watermark="9"
                                     ToolTip.Tip="Primary UDP port (default: 9). Port 7 and custom RDP ports (e.g. port 11) are also automatically targeted."/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="4">
                            <TextBlock Text="Wait delay (sec)" FontSize="12" Foreground="#8A8A93"/>
                            <TextBox Name="TxtWolWait" Watermark="5"
                                     ToolTip.Tip="Seconds to wait after sending WOL magic packet before launching Remote Desktop (0-300)."/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="💡 Packets are automatically sent to the Host IP, local subnet broadcasts, and custom ports."
                               FontSize="11" Foreground="#8A8A93" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Background="#121215" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <CheckBox Name="ChkIcmpKnock" Content="Enable Port Knocking (send ICMP magic packet before connecting)"/>
                <StackPanel Name="PnlIcmpKnockDetails" Spacing="8" IsVisible="False">
                    <TextBlock Text="Sends an out-of-the-ordinary ICMP knock payload to the destination IP, waits 2 seconds, then connects to the custom RDP port. Firewall must be configured to trigger on this knock signature."
                               TextWrapping="Wrap" Foreground="#8A8A93" FontSize="12"/>
                    <TextBox Name="TxtIcmpSignature" Watermark="Generate or enter hexadecimal bytes" TextWrapping="Wrap"/>
                    <Button Name="BtnGenerateIcmpSignature" Content="Generate unique signature"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Local resources -->
        <TextBlock Text="Local resources to share with the remote PC" FontSize="13" FontWeight="Bold"
                   Foreground="#8A8A93" Margin="0,10,0,0"/>
        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
            <CheckBox Name="ChkClipboard" Content="Clipboard" Margin="0,0,15,5"
                      ToolTip.Tip="Allow clipboard sharing (copy/paste) between local and remote PC. Can override global vault setting."/>
            <CheckBox Name="ChkDrives" Content="Drives" Margin="0,0,15,5"/>
            <CheckBox Name="ChkPrinters" Content="Printers" Margin="0,0,15,5"/>
            <CheckBox Name="ChkSmartCards" Content="Smart cards" Margin="0,0,15,5"/>
        </WrapPanel>

        <Border Background="#121215" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="4"
                Padding="10" Margin="0,8,0,0">
            <StackPanel Spacing="4">
                <CheckBox Name="ChkAllowUnverified">
                    <TextBlock Text="Never check this server's identity (allow unverified server)"
                               TextWrapping="Wrap" Foreground="#EDEDED"/>
                </CheckBox>
                <TextBlock Text="When enabled, bypasses server identity checks entirely on connection."
                           FontSize="11" Foreground="#8A8A93" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Name="TxtError" Foreground="#E83030" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
            <Button Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"/>
            <Button Name="BtnSave" Content="Save Profile" Classes="Accent" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
