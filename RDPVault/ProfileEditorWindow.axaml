<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RDPVault.ProfileEditorWindow"
        Title="Edit Profile" Width="400" Height="500"
        WindowStartupLocation="CenterOwner" CanResize="False" Background="#11151A">
  <StackPanel Margin="24" Spacing="10">
    <TextBlock Text="Edit Profile" FontSize="20" FontWeight="Bold" Foreground="White" />
    <TextBlock Text="Name" Foreground="White"/>
    <TextBox x:Name="TxtName" />
    <TextBlock Text="Host / IP" Foreground="White"/>
    <TextBox x:Name="TxtHost" />
    <TextBlock Text="Username" Foreground="White"/>
    <TextBox x:Name="TxtUsername" />
    <TextBlock Text="Password" Foreground="White"/>
    <TextBox x:Name="TxtPassword" PasswordChar="•" />
    <CheckBox x:Name="ChkMultiMon" Content="Use Multiple Monitors" Foreground="White" Margin="0,10,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
      <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"/>
      <Button x:Name="BtnSave" Content="Save" Click="BtnSave_Click" Background="#26A0DA" Foreground="White"/>
    </StackPanel>
  </StackPanel>
</Window>
